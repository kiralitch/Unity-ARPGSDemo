ility = ability;\n351\t        EnemyComboIndex = 0;\n352\t        EnemyComboActivePort = attackInputPort;\n353\t        bEnemyComboPreloaded = false;\n354\t\n355\t        //第一个端口立刻播放第一段，第二端口预缓存第二段（没有第二段则缓存第一段占位）\n356\t        CacheEnemyComboClipAt(graph, EnemyComboActivePort, EnemyComboIndex);\n357\t        CacheEnemyComboClipAt(graph, EnemyComboPreloadPort, EnemyComboIndex + 1);\n358\t\n359\t        AttackMixer.SetInputWeight(EnemyComboActivePort, 1f);\n360\t        AttackMixer.SetInputWeight(EnemyComboPreloadPort, 0f);\n361\t        SetRootTarget(0f, 1f, 0f); // 切换到攻击权重\n362\t\n363\t        return true;\n364\t    }\n365\t\n366\t    /* 推进到下一段连招：交换端口，当前段播完后由预缓存段接管，\n367\t     * 同时在腾空的端口上缓存再下一段。\n368\t     * 已是最后一段时返回 false，由调用方决定如何结束攻击。 */\n369\t    public bool PlayNextEnemyComboClip(PlayableGraph graph)\n370\t    {\n371\t        if (!bHasNextEnemyCombo) return false;\n372\t\n373\t        //预缓存段直接接管播放，不需要重新连接，避免切换瞬间出现空端口\n374\t        if (!bEnemyComboPreloaded)\n375\t        {\n376\t            CacheEnemyComboClipAt(graph, EnemyComboPreloadPort, EnemyComboIndex + 1);\n377\t        }\n378\t\n379\t        int NextPort = EnemyComboPreloadPort;\n380\t\n381\t        EnemyComboIndex++;\n382\t        EnemyComboActivePort = NextPort;\n383\t        bEnemyComboPreloaded = false;\n384\t\n385\t        //权重交接与端口交换在同一帧完成\n386\t        AttackMixer.SetInputWeight(EnemyComboActivePort, 1f);\n387\t        AttackMixer.SetInputWeight(EnemyComboPreloadPort, 0f);\n388\t\n389\t        //在刚刚腾空的端口上缓存再下一段，为下一次切换做准备。\n390\t        //这一步会先 Destroy 掉该端口上刚播完的旧节点，不会累积泄漏\n391\t        CacheEnemyComboClipAt(graph, EnemyComboPreloadPort, EnemyComboIndex + 1);\n392\t\n393\t        SetRootTarget(0f, 1f, 0f); // 保持攻击权重\n394\t        return true;\n395\t    }\n396\t\n397\t    /* 在指定端口上覆盖连接一段连招动画，并把播放时间与结束标记复位 */\n398\t    private void CacheEnemyComboClipAt(PlayableGraph graph, int port, int index)\n399\t    {\n400\t        var ComboClips = CurrentEnemyAbility.AttackClips;\n401\t\n402\t        //越界说明没有下一段