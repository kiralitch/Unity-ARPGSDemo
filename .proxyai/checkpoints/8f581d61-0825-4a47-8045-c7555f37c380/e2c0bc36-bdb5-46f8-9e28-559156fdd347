ebug.LogError(\"AttackMixer未初始化！\");\n411\t            return false;\n412\t        }\n413\t\n414\t        if (ability.AttackClips == null || ability.AttackClips.Count == 0)\n415\t        {\n416\t            Debug.LogError($\"技能 {ability.skillName} 的连招动画列表为空！\");\n417\t            return false;\n418\t        }\n419\t\n420\t        CurrentEnemyAbility = ability;\n421\t        EnemyComboIndex = 0;\n422\t        EnemyComboActivePort = attackInputPort;\n423\t        bEnemyComboPreloaded = false;\n424\t\n425\t        //第一个端口立刻播放第一段，第二端口预缓存第二段（没有第二段则缓存第一段占位）\n426\t        CacheEnemyComboClipAt(graph, EnemyComboActivePort, EnemyComboIndex);\n427\t        CacheEnemyComboClipAt(graph, EnemyComboPreloadPort, EnemyComboIndex + 1);\n428\t\n429\t        AttackMixer.SetInputWeight(EnemyComboActivePort, 1f);\n430\t        AttackMixer.SetInputWeight(EnemyComboPreloadPort, 0f);\n431\t        SetRootTarget(0f, 1f, 0f); // 切换到攻击权重\n432\t\n433\t        return true;\n434\t    }\n435\t\n436\t    /* 推进到下一段连招：交换端口，当前段播完后由预缓存段接管。\n437\t     * 已是最后一段时返回 false，由调用方决定如何结束攻击。\n438\t     *\n439\t     * 注意：这里刻意不在切换后立刻给腾空的端口预缓存下一段。\n440\t     * CreateAttackPlayable 会 Disconnect + Connect，改变该端口的输入对象，\n441\t     * 而 AnimationMixerPlayable 在输入被替换的那一帧会重建内部混合缓冲，\n442\t     * 该帧求值会闪出绑定姿势（表现为第一招切第二招时闪一下骨骼拉长）。\n443\t     * 预缓存推迟到下一帧由 PreloadNextEnemyComboIfNeeded 完成，\n444\t     * 保证「权重交接」和「端口重建」永远不在同一帧发生 */\n445\t    public bool PlayNextEnemyComboClip(PlayableGraph graph)\n446\t    {\n447\t        if (!bHasNextEnemyCombo) return false;\n448\t\n449\t        //先记下本次要停用（腾空）的端口。必须在交换 ActivePort 之前取，\n450\t        //否则 EnemyComboPreloadPort 会翻转成正在播放的端口\n451\t        int VacatedPort = EnemyComboActivePort;\n452\t        int NextPort = EnemyComboPreloadPort;\n453\t\n454\t        //预缓存段直接接管播放，不需要重新连接，避免切换瞬间出现空端口\n455\t        if (!bEnemyComboPreloaded)\n456\t        {\n457\t            CacheEnemyComboClipAt(graph, NextPort, EnemyComboIndex + 1);\n458\t        }\n459\t\n460\t        EnemyComboIndex++;\n461\t        EnemyComboActivePort = NextPort;\n462\t        bEnemyComboPreloaded = false;\n463\t\n464\t        //权重交接：两个端口在同一帧内写入，和不超过 1\n465\t        AttackMixer.SetInputWeight(EnemyComboActivePort, 1f);\n466\t        AttackMixer.SetInputWeight(VacatedPort, 0f);\n467\t\n468\t        //标记腾空端口待预缓存，实际重建留到下一帧，避免与权重交接同帧\n469\t        PendingPreloadPort = VacatedPort;\n470\t        bHasPendingPreload = true;\n471\t\n472\t        SetRootTarget(0f, 1f, 0f); // 保持攻击权重\n473\t        return true;\n474\t    }\n475\t\n476\t    /* 在安全的帧上补上腾空端口的预缓存。由 UpdateBlend 每帧调用，\n477\t       与权重交接错开一帧，避免同帧重建端口导致的绑定姿势闪烁。\n478\t       这里用 Initialize 时缓存的 graph，不需要外部再传 */\n479\t    private void PreloadNextEnemyComboIfNeeded()\n480\t    {\n481\t        if (!bHasPendingPreload) return;\n482\t\n483\t        bHasPendingPreload = false;\n484\t\n485\t        if (CurrentEnemyAbility == null) return;\n486\t        if (!graph.IsValid()) return;\n487\t\n488\t        //只在端口确实腾空（权重为 0）时才重建，避免打断正在播放的段\n489\t        if (PendingPreloadPort < 0 || PendingPreloadPort == EnemyComboActivePort) return;\n490\t        if (AttackMixer.GetInputWeight(PendingPreloadPort) > 0.0001f) return;\n491\t\n492\t        CacheEnemyComboClipAt(graph, PendingPreloadPort, EnemyComboIndex + 1);\n493\t    }\n494\t\n495\t    /* 在指定端口上覆盖连接一段连招动画，并把播放时间与结束标记复位 */\n496\t    private void CacheEnemyComboClipAt(PlayableGraph graph, int port, int index)\n497\t    {\n498\t        var ComboClips = CurrentEnemyAbility.AttackClips;\n499\t\n500\t        //越界说明没有下一段了，用第一段占位，保证端口永远有效，不会退化成绑定姿势\n501\t        bool bHasRealClip = index >= 0 && index < ComboClips.Count;\n502\t        int ClipIndex = bHasRealClip ? index : 0;\n503\t\n504\t        CreateAttackPlayable(\n505\t            graph,\n506\t            ComboClips[ClipIndex],\n507\t            port,\n508\t            CurrentEnemyAbility.animationSpeed);\n509\t\n510\t        //只有缓存到真正的下一段才算预缓存完成，占位动画不能置位\n511\t        if (bHasRealClip && port != EnemyComboActivePort) bEnemyComboPreloaded = true;\n512\t    }\n