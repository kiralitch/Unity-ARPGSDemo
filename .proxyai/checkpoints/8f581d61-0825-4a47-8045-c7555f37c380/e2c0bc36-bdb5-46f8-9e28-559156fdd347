                    "text": "1\tusing System;\n2\tusing System.Collections;\n3\tusing System.Collections.Generic;\n4\tusing UnityEngine;\n5\t\n6\tpublic class AIC_CommonEnemy : CommonAIController\n7\t{\n8\t    public Enemy EnemyRef { get; private set; }\n9\t    public Enemy_AISight AISight;\n10\t    \n11\t    private CommonAIBlackBoard EnemyBlackBoard;\n12\t    private Dictionary<string, Action <bool> > blackboardCallbacks = new Dictionary<string, Action <bool> >();\n13\t\n14\t    public override void Initialize(Enemy enemy)\n15\t    {\n16\t        base.Initialize(enemy);\n17\t\n18\t        AISight = new Enemy_AISight();\n19\t        EnemyRef = enemy;\n20\t        if (EnemyRef != null && EnemyRef.AIBlackBoardData != null)\n21\t        {\n22\t            EnemyBlackBoard = EnemyRef.AIBlackBoardData.Values;\n23\t        }\n24\t    }\n25\t\n26\t    #region 玩家位置\n27\t\n28\t    /* 当前锁定的玩家（视野检测成功后缓存，丢失视野则为 null） */\n29\t    public Transform CachedPlayerTransform\n30\t    {\n31\t        get\n32\t        {\n33\t            if (EnemyRef == null || EnemyRef.CommonSO == null) return null;\n34\t\n35\t            return EnemyRef.CommonSO.GroundedData.CachedPlayerTransform;\n36\t        }\n37\t    }\n38\t\n39\t    /* 判断当前是否持有有效的玩家目标 */\n40\t    public bool HasPlayerTarget()\n41\t    {\n42\t        return CachedPlayerTransform != null;\n43\t    }\n44\t\n45\t    /* 获取玩家位置，没有目标时返回 false，Position 为敌人自身位置 */\n46\t    public bool TryGetPlayerPosition(out Vector3 Position)\n47\t    {\n48\t        Transform player = CachedPlayerTransform;\n49\t\n50\t        if (player == null)\n51\t        {\n52\t            Position = EnemyRef != null ? EnemyRef.transform.position : Vector3.zero;\n53\t            return false;\n54\t        }\n55\t\n56\t        Position = player.position;\n57\t\n58\t        return true;\n59\t    }\n60\t\n61\t    /* 获取从敌人指向玩家的水平方向（已去掉 y 轴），没有目标或完全重合时返回 false */\n62\t    public bool TryGetDirectionToPlayer(out Vector3 Direction)\n63\t    {\n64\t        Direction = Vector3.z