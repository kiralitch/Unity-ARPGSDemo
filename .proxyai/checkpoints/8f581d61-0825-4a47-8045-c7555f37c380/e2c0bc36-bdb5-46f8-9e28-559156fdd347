n.y = 0f;\n55\t        if (Direction.sqrMagnitude < 0.0001f) return;\n56\t\n57\t        Transform Root = RotationTransform;\n58\t        float TargetYAngle = Mathf.Atan2(Direction.x, Direction.z) * Mathf.Rad2Deg;\n59\t        float CurrentYAngle = Root.eulerAngles.y;\n60\t\n61\t        float SmoothYAngle = Mathf.SmoothDampAngle(\n62\t            CurrentYAngle,\n63\t            TargetYAngle,\n64\t            ref CurrentAttackRotationVelocity,\n65\t            Mathf.Max(ReachTime, 0.0001f)\n66\t            );\n67\t\n68\t        Root.rotation = Quaternion.Euler(0f, SmoothYAngle, 0f);\n69\t    }\n70\t\n71\t    /* 打断旋转平滑，避免下一次攻击继承上一次的角速度 */\n72\t    public void ResetRotationVelocity()\n73\t    {\n74\t        CurrentAttackRotationVelocity = 0f;\n75\t    }\n76\t\n77\t    private Coroutine AISightCoroutine;\n78\t\n79\t    private void Awake()\n80\t    {\n81\t        animator = GetComponentInChildren<Animator>();\n82\t\n83\t        /* 本角色位移完全交给 NavMeshAgent，动画只负责姿势。\n84\t           若 Animator 开着 applyRootMotion，动画里的根骨骼位移会直接叠加到\n85\t           transform 上，把模型推离碰撞体（表现为模型飘在天上、骨骼被拉长），\n86\t           同时和 Agent 的转向互相打架导致抖动，这里强制关掉 */\n87\t        if (animator != null)\n88\t        {\n89\t            animator.applyRootMotion = false;\n90\t        }\n91\t\n92\t        MovementStateMachine = new Enemy_MovementStateMachine(this);\n93\t        CombatStateMachine = new Enemy_CombatStateMachine(this);\n94\t        AIController = GetComponent<AIC_CommonEnemy>();\n95\t        if (AIController != null)\n96\t        {\n97\t            AIController.Initialize(this);\n98\t            CommonSO.GroundedData.InitializeAgent(AIController.Agent);\n99\t        }\n100\t\n101\t        HitBoxUtils = HitBoxesTrans.GetComponentInChildren<SharedWeaponHitBox>();\n102\t\n103\t        if (CommonAssetData.EnemyCommonData.CurrentHealth < CommonAssetData.EnemyCommonData.MaxHealth)\n104\t        {\n105\t            CommonAssetData.EnemyCommonData.CurrentHealth = CommonAssetData.EnemyCommonData.MaxHealth;\n106\t 