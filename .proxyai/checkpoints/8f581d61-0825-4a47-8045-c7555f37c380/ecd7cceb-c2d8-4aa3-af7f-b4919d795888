                    "text": "1\tusing System;\n2\tusing System.Collections;\n3\tusing System.Collections.Generic;\n4\tusing UnityEngine;\n5\t\n6\tpublic class AIC_CommonEnemy : CommonAIController\n7\t{\n8\t    public Enemy EnemyRef { get; private set; }\n9\t    public Enemy_AISight AISight;\n10\t    \n11\t    private CommonAIBlackBoard EnemyBlackBoard;\n12\t    private Dictionary<string, Action <bool> > blackboardCallbacks = new Dictionary<string, Action <bool> >();\n13\t\n14\t    public override void Initialize(Enemy enemy)\n15\t    {\n16\t        base.Initialize(enemy);\n17\t\n18\t        AISight = new Enemy_AISight();\n19\t        EnemyRef = enemy;\n20\t        if (EnemyRef != null && EnemyRef.AIBlackBoardData != null)\n21\t        {\n22\t            EnemyBlackBoard = EnemyRef.AIBlackBoardData.Values;\n23\t        }\n24\t    }\n25\t\n26\t    #region 玩家位置\n27\t\n28\t    /* 当前锁定的玩家（视野检测成功后缓存，丢失视野则为 null） */\n29\t    public Transform CachedPlayerTransform\n30\t    {\n31\t        get\n32\t        {\n33\t            if (EnemyRef == null || EnemyRef.CommonSO == null) return null;\n34\t\n35\t            return EnemyRef.CommonSO.GroundedData.CachedPlayerTransform;\n36\t        }\n37\t    }\n38\t\n39\t    /* 判断当前是否持有有效的玩家目标 */\n40\t    public bool HasPlayerTarget()\n41\t    {\n42\t        return CachedPlayerTransform != null;\n43\t    }\n44\t\n45\t    /* 获取玩家位置，没有目标时返回 false，Position 为敌人自身位置 */\n46\t    public bool TryGetPlayerPosition(out Vector3 Position)\n47\t    {\n48\t        Transform player = CachedPlayerTransform;\n49\t\n50\t        if (player == null)\n51\t        {\n52\t            Position = EnemyRef != null ? EnemyRef.transform.position : Vector3.zero;\n53\t            return false;\n54\t        }\n55\t\n56\t        Position = player.position;\n57\t\n58\t        return true;\n59\t    }\n60\t\n61\t    /* 获取从敌人指向玩家的水平方向（已去掉 y 轴），没有目标或完全重合时返回 false */\n62\t    public bool TryGetDirectionToPlayer(out Vector3 Direction)\n63\t    {\n64\t        Direction = Vector3.zero;\n65\t\n66\t        if (EnemyRef == null) return false;\n67\t\n68\t        Vector3 delta = CachedPlayerTransform.position - EnemyRef.transform.position;\n69\t        delta.y = 0f;\n70\t\n71\t        if (delta.sqrMagnitude < 0.0001f) return false; //玩家与敌人位置重合，无法得到朝向\n72\t\n73\t        Direction = delta.normalized;\n74\t\n75\t        return true;\n76\t    }\n77\t\n78\t    /* 获取敌人与玩家的水平距离（忽略高度差），没有目标时返回 float.MaxValue */\n79\t    public float GetDistanceToPlayer()\n80\t    {\n81\t        if (!TryGetPlayerPosition(out Vector3 PlayerPosition)) return float.MaxValue;\n82\t\n83\t        Vector3 delta = PlayerPosition - EnemyRef.transform.position;\n84\t        delta.y = 0f;\n85\t\n86\t        return delta.magnitude;\n87\t    }\n88\t\n89\t    /* 玩家是否已进入攻击距离，distance 为攻击判定距离（米） */\n90\t    public bool IsPlayerInAttackRange(float distance)\n91\t    {\n92\t        return GetDistanceToPlayer() <= distance;\n93\t    }\n94\t\n95\t    /* 玩家是否已进入攻击距离，并且确实在视野/锁定目标中 */\n96\t    public bool IsPlayerInAttackRange(float distance, out float currentDistance)\n97\t    {\n98\t        currentDistance = GetDistanceToPlayer();\n99\t\n100\t        return HasPlayerTarget() && currentDistance <= distance;\n101\t    }\n102\t\n103\t    /* 使用 GroundedData 里配置的 AttackRange 判断玩家是否在攻击距离内 */\n104\t    public bool IsPlayerInAttackRange()\n105\t    {\n106\t        if (EnemyRef == null || EnemyRef.CommonSO == null) return false;\n107\t\n108\t        return IsPlayerInAttackRange(EnemyRef.CommonSO.GroundedData.AttackRange);\n109\t    }\n110\t\n111\t    #endregion\n112\t\n113\t    #region 主方法\n114\t\n115\t    /* 攻击进行中标记：被置位时视野协程不再改写 Idle / ChasePlayer 黑板，\n116\t       避免攻击期间黑板值被覆盖导致状态机反复切换产生抖动 */\n117\t    private bool bIsAttacking;\n118\t\n119\t    /* 由 Enemy 在进入 / 退出攻击状态时调用 */\n120\t    public void SetAttacking(bool bAttacking)\n121\t    {\n122\t        bIsAttacking = bAttacking;\n123\t    }\n124\t\n125\t    /* 当前是否处于攻击流程中 */\n126\t    public bool IsAttacking()\n127\t    {\n128\t        return bIsAttacking;\n129\t    }\n130\t\n131\t    /* 视野刷新专用：攻击期间忽略，其余情况按输入索引正常设置 */\n132\t    public void SetSightBlackBoardValue(string name, bool setbool = true)\n133\t    {\n134\t        if (bIsAttacking) return;\n135\t\n136\t        SetBlackBoardValue(name, setbool);\n137\t    }\n138\t\n139\t    public void RegisterBlackboardCallback(string name, Action<bool> callback)\n140\t    {\n141\t        blackboardCallbacks[name] = callback;\n142\t    }\n143\t\n144\t    public void UnBindAllBlackboardCallback()\n145\t    {\n146\t        blackboardCallbacks.Clear();\n147\t    }\n148\t\n149\t    /* 通过输入索引设置该黑板值，如果注册了回调函数则在设置的时候会调用回调函数 */\n150\t    public void SetBlackBoardValue(string name, bool setbool = true)\n151\t    {\n152\t        if (EnemyBlackBoard == null) return;\n153\t\n154\t        /* 先把本次要设置的值写进黑板并触发回调，清空其他黑板值的操作交给回调内部去做。\n155\t           否则 SetBlackBoardValue(\"Attack\", true) 会在调用回调前先把 Attack 重新置为 false，\n156\t           回调内部若再次读取该值就会直接返回，导致攻击永远触发不了 */\n157\t        bool bFound = false;\n158\t        bool bChanged = false;\n159\t\n160\t        for (int i = 0; i < EnemyBlackBoard.BlackboardValues.Count; i++)\n161\t        {\n162\t            if (EnemyBlackBoard.BlackboardValues[i].ValueName != name) continue;\n163\t\n164\t            Blackboard temp = EnemyBlackBoard.BlackboardValues[i];\n165\t            bool previous = temp.bIsOn;\n166\t\n167\t            temp.bIsOn = setbool;\n168\t            EnemyBlackBoard.BlackboardValues[i] = temp;\n169\t\n170\t            bFound = true;\n171\t            bChanged = previous != setbool; //如果现在的布尔不等于设置的布尔则为true\n172\t\n173\t            break;\n174\t        }\n175\t\n176\t        if (!bFound) return;\n177\t\n178\t        //回调内部通过 SetBlackBoardValue 清空其他黑板值，这里不会重复清空\n179\t        if (bChanged && blackboardCallbacks.TryGetValue(name, out Action<bool> callback))\n180\t        {\n181\t            callback?.Invoke(setbool);\n182\t        }\n183\t\n184\t        /* 目标值不存在时也应该清掉其他黑板，保证同一时刻只有一个激活值 */\n185\t        if (bChanged) ResetAllBlackboardButInputNone(name);\n186\t    }\n187\t\n188\t    /* 返回黑板值，默认false */\n189\t    public bool GetBlackBoardValue(string name)\n190\t    {\n191\t        foreach (var value in EnemyBlackBoard.BlackboardValues)\n192\t        {\n193\t            if(value.ValueName == name) return value.bIsOn;\n194\t        }\n195\t\n196\t        return false;\n197\t    }\n198\t\n199\t    public void ResetAllBlackboardButInputNone(string name)\n200\t    {\n201\t        for (int i = 0; i < EnemyBlackBoard.BlackboardValues.Count; i++)\n202\t        {\n203\t            Blackboard temp = EnemyBlackBoard.BlackboardValues[i];\n204\t            if(!temp.bIsOn) continue;\n205\t            if(temp.ValueName.Equals(name)) continue;\n206\t            \n207\t            temp.bIsOn = false;\n208\t            EnemyBlackBoard.BlackboardValues[i] = temp;\n209\t        }\n210\t    }\n211\t\n212\t    /* 将所有黑板设为false */\n213\t    public void ResetAllBlackboard()\n214\t    {\n215\t        for (int i = 0; i < EnemyBlackBoard.BlackboardValues.Count; i++)\n216\t        {\n217\t            Blackboard temp = EnemyBlackBoard.BlackboardValues[i];\n218\t            if(!temp.bIsOn) continue;\n219\t            \n220\t            temp.bIsOn = false;\n221\t            EnemyBlackBoard.BlackboardValues[i] = temp;\n222\t        }\n223\t    }\n224\t\n225\t    /* 默认设置第一个索引为true */\n226\t    public void SetFristValue()\n227\t    {\n228\t        Blackboard frist = EnemyBlackBoard.BlackboardValues[0];\n229\t        frist.bIsOn = true;\n230\t        EnemyBlackBoard.BlackboardValues[0] = frist;\n231\t    }\n232\t\n233\t    #endregion\n234\t}\n235"
