                    "text": "1\tusing System.Collections;\n2\tusing System.Collections.Generic;\n3\tusing UnityEngine;\n4\t\n5\tpublic class Enemy_HitReact : Enemy_GroundedState\n6\t{\n7\t    private CommonActor ExecutorRef;\n8\t\n9\t    /* 本次受击锁定下来的后退方向与朝向（受击瞬间决定，之后不再跟着攻击者变） */\n10\t    private Vector3 HitBackDirection;\n11\t    private Vector3 FacingDirection;\n12\t\n13\t    /* 受击瞬间记录的攻击者位置 */\n14\t    private Vector3 LockedExecutorPosition;\n15\t\n16\t    private bool bHasLockedTarget = false;\n17\t\n18\t    /* 后退位移已经完成，不再做任何表现控制 */\n19\t    private bool bKnockbackFinished = false;\n20\t\n21\t    /* 后退剩余的位移量（米）与剩余时间，用来推进速度曲线 */\n22\t    private float RemainingKnockbackDistance;\n23\t    private float RemainingKnockbackTime;\n24\t\n25\t    private Rigidbody CachedRigidBody;\n26\t    private bool bHasCachedRigidBody;\n27\t\n28\t    /* 是否有一根受击期间被我们改成非 kinematic 的刚体需要在退出时还原 */\n29\t    private bool bRestoredRigidBodyKinematic;\n30\t\n31\t    /* 后退期间刚体原来的重力设置，退出时还原 */\n32\t    private bool CachedUseGravity;\n33\t\n34\t    private Enemy_GroundData GroundedData => stateMachine.EnemyRef.CommonSO.GroundedData;\n35\t\n36\t    public Enemy_HitReact(Enemy_MovementStateMachine StateMachineRef) : base(StateMachineRef)\n37\t    {\n38\t\n39\t    }\n40\t\n41\t    public override void Enter()\n42\t    {\n43\t        base.Enter();\n44\t\n45\t        /* 受击期间不再追击/攻击，这里停掉 Agent，否则受击动画会推着敌人继续滑向玩家。\n46\t           Agent 停住之后它也就不会再写 transform，位置可以安全地交给受击位移控制 */\n47\t        StopAgentMovement();\n48\t        CheckPlayerPositon();\n49\t\n50\t        stateMachine.EnemyRef.AnimationClipData.ResetCommonReactionAnimationTime(0);\n51\t        stateMachine.EnemyRef.AnimationClipData.SetCommonReacitonTarget(0);\n52\t        stateMachine.EnemyRef.AnimationClipData.SetRootTarget(0, 0, 1);\n53\t    }\n54\t\n55\t    /* 受击瞬间锁定后退方向与朝向，并把后退量算成初速度交给刚体 */\n56\t    private void CheckPlayerPositon()\n57\t    {\n58\t        bHasLockedTarget = false;\n59\t        bKnockbackFinished = false;\n60\t\n61\t        HitBackDirection = Vector3.zero;\n62\t        FacingDirection = Vector3.zero;\n63\t        RemainingKnockbackDistance = 0f;\n64\t        RemainingKnockbackTime = 0f;\n65\t\n66\t        if (ExecutorRef == null) return;\n67\t\n68\t        LockedExecutorPosition = ExecutorRef.transform.position;\n69\t\n70\t        Vector3 BackDir = stateMachine.EnemyRef.transform.position - LockedExecutorPosition;\n71\t        BackDir.y = 0f;\n72\t\n73\t        /* 敌人与攻击者位置完全重合时没有有效的后退方向，\n74\t           此时只做朝向，不做位移，避免沿 NaN 方向把敌人推飞 */\n75\t        if (BackDir.sqrMagnitude < 0.0001f)\n76\t        {\n77\t            Debug.LogWarning($\"{stateMachine.EnemyRef.name} 与攻击者 {ExecutorRef.name} 位置重合，本次受击不产生后退位移\");\n78\t            return;\n79\t        }\n80\t\n81\t        HitBackDirection = BackDir.normalized;\n82\t\n83\t        /* 正对着攻击者，也就是背对着后退方向 */\n84\t        FacingDirection = -HitBackDirection;\n85\t\n86\t        bHasLockedTarget = true;\n87\t\n88\t        RemainingKnockbackDistance = GroundedData.HitKnockbackDistance;\n89\t        RemainingKnockbackTime = GroundedData.HitKnockbackDuration;\n90\t\n91\t        TryStartRigidbodyKnockback();\n92\t    }\n93\t\n94\t    #region 刚体后退\n95\t\n96\t    /* 受击后退优先交给刚体：敌人平时是 kinematic，完全由 Agent 写位置，\n97\t       这里临时解除 kinematic 才能用速度推动 */\n98\t    private void TryStartRigidbodyKnockback()\n99\t    {\n100\t        if (!GroundedData.bUseRigidbodyKnockback) return;\n101\t\n102\t        Rigidbody Body = GetRigidBody();\n103\t        if (Body == null || !Body.enabled) return;\n104\t\n105\t        CachedUseGravity = Body.useGravity;\n106\t\n107\t        if (Body.isKinematic)\n108\t        {\n109\t            Body.isKinematic = false;\n110\t            bRestoredRigidBodyKinematic = true;\n111\t        }\n112\t\n113\t        /* 受击期间不要重力：敌人高度由地面贴合逻辑负责，\n114\t           交给重力会让胶囊体缓慢下沉到地面以下 */\n115\t        Body.useGravity = false;\n116\t\n117\t        /* 清掉残留速度，保证后退初速度完全由本次受击决定 */\n118\t        Body.velocity = Vector3.zero;\n119\t        Body.angularVelocity = Vector3.zero;\n120\t\n121\t        Body.AddForce(HitBackDirection * GroundedData.HitKnockbackSpeed, ForceMode.VelocityChange);\n122\t\n123\t        Debug.Log($\"{stateMachine.EnemyRef.name} 受击后退：方向 {HitBackDirection}，初速度 {GroundedData.HitKnockbackSpeed}\");\n124\t    }\n125\t\n126\t    /* 刚体后退：每帧施加反向加速度把速度衰减到 0，\n127\t       这样前后两帧速度都由代码给定，实际位移不会被物理解算结果带偏 */\n128\t    private void PhysicsUpdateRigidbodyKnockback()\n129\t    {\n130\t        Rigidbody Body = GetRigidBody();\n131\t        if (Body == null || Body.isKinematic) return;\n132\t\n133\t        Vector3 HorizontalVelocity = Body.velocity;\n134\t        HorizontalVelocity.y = 0f;\n135\t\n136\t        /* 速度方向与后退方向相反说明位移已经超出目标距离（例如被撞墙弹回），\n137\t           继续衰减只会把它推得更远，直接停住 */\n138\t        if (Vector3.Dot(HorizontalVelocity, HitBackDirection) <= 0f)\n139\t        {\n140\t            Body.velocity = Vector3.zero;\n141\t            return;\n142\t        }\n143\t\n144\t        Body.AddForce(-HitBackDirection * GroundedData.HitKnockbackDrag, ForceMode.Acceleration);\n145\t    }\n146\t\n147\t    #endregion\n148\t\n149\t    #region 运动学后退\n150\t\n151\t    /* 刚体被禁用或不允许脱离 kinematic 时的兜底：按「速度曲线 × 时间」逐帧推 transform，\n152\t       推完再用 Agent.Warp 把 NavMesh 上的位置同步过去 */\n153\t    private void UpdateKinematicKnockback(float DeltaTime)\n154\t    {\n155\t        /* Duration 执行过程中被改小（例如 Inspector 里调参）时按当前值收口，\n156\t           避免剩余时间大于总时长导致速度曲线反向 */\n157\t        if (RemainingKnockbackTime > GroundedData.HitKnockbackDuration)\n158\t        {\n159\t            RemainingKnockbackTime = GroundedData.HitKnockbackDuration;\n160\t        }\n161\t\n162\t        float Progress = GroundedData.HitKnockbackDuration - RemainingKnockbackTime;\n163\t        float Speed = GroundedData.HitKnockbackSpeed * (1f - Progress / GroundedData.HitKnockbackDuration);\n164\t        float Step = Mathf.Min(Speed * DeltaTime, RemainingKnockbackDistance);\n165\t\n166\t        if (Step > 0f)\n167\t        {\n168\t            Vector3 NewPosition = stateMachine.EnemyRef.transform.position + HitBackDirection * Step;\n169\t\n170\t            /* 走 NavMesh 采样而不是直接赋位置：墙面和台阶会被挡住，\n171\t               敌人不会因为受击被推进墙里或者掉出导航网格 */\n172\t            if (UnityEngine.AI.NavMesh.SamplePosition(NewPosition, out UnityEngine.AI.NavMeshHit Hit, 0.5f, NavMesh.AllAreas))\n173\t            {\n174\t                NewPosition = Hit.RandomPositionInRadius(Hit.position, HitBackDirection, Step);\n175\t            }\n176\t\n177\t            stateMachine.EnemyRef.transform.position = NewPosition;\n178\t        }\n179\t\n180\t        RemainingKnockbackDistance -= Step;\n181\t        RemainingKnockbackTime -= DeltaTime;\n182\t    }\n183\t\n184\t    #endregion\n185\t\n186\t    /* 受击状态覆盖基类的 PhysicsUpdate：基类会在玩家进入攻击范围时触发攻击，\n187\t       受击动画播完立刻接一段攻击，表现上就是「每次受击后都打一下」。\n188\t       受击期间完全不参与追击与攻击判定 */\n189\t    public override void PhysicsUpdate()\n190\t    {\n191\t        if (!bHasLockedTarget) return;\n192\t\n193\t        RotateTowardsExecutor();\n194\t\n195\t        UpdateKnockback();\n196\t    }\n197\t\n198\t    /* 每次物理帧都朝受击瞬间锁定的攻击者位置转，转到目标朝向之后不再写旋转 */\n199\t    private void RotateTowardsExecutor()\n200\t    {\n201\t        if (Vector3.Angle(stateMachine.EnemyRef.RotationTransform.forward, FacingDirection) <= 1f) return;\n202\t\n203\t        stateMachine.EnemyRef.RotateTowards(FacingDirection, GroundedData.HitFacingReachTime);\n204\t    }\n205\t\n206\t    private void UpdateKnockback()\n207\t    {\n208\t        if (bKnockbackFinished) return;\n209\t\n210\t        Rigidbody Body = GetRigidBody();\n211\t\n212\t        /* 刚体可用时由物理引擎推进位移，动画只负责姿势 */\n213\t        if (Body != null && !Body.isKinematic)\n214\t        {\n215\t            PhysicsUpdateRigidbodyKnockback();\n216\t            return;\n217\t        }\n218\t\n219\t        if (RemainingKnockbackTime <= 0f) return;\n220\t\n221\t        UpdateKinematicKnockback(Time.fixedDeltaTime);\n222\t\n223\t        if (RemainingKnockbackDistance > 0f && RemainingKnockbackTime > 0f) return;\n224\t\n225\t        bKnockbackFinished = true;\n226\t        WarpAgentToCurrentPosition();\n227\t    }\n228\t\n229\t    public override void Exit()\n230\t    {\n231\t        base.Exit();\n232\t\n233\t        StopKnockback();\n234\t        ResumeAgentMovement();\n235\t    }\n236\t\n237\t    /* 退出受击：清速度、把刚体恢复成 kinematic 与原来的重力设置，\n238\t       位置交接给 Agent（Warp 到当前位置再恢复寻路，避免恢复控制时弹回受击前的位置） */\n239\t    private void StopKnockback()\n240\t    {\n241\t        RestoreRigidBody();\n242\t\n243\t        bHasLockedTarget = false;\n244\t        bKnockbackFinished = true;\n245\t        RemainingKnockbackDistance = 0f;\n246\t        RemainingKnockbackTime = 0f;\n247\t\n248\t        stateMachine.EnemyRef.ResetRotationVelocity();\n249\t    }\n250\t\n251\t    public override void OnAnimationTransitionEvent()\n252\t    {\n253\t        base.OnAnimationTransitionEvent();\n254\t\n255\t        stateMachine.ChangeState(stateMachine.IdleState);\n256\t    }\n257\t\n258\t    /* 停住 NavMeshAgent，受击位移完全由受击状态与动画负责 */\n259\t    private void StopAgentMovement()\n260\t    {\n261\t        var Agent = stateMachine.EnemyRef.AIController?.Agent;\n262\t        if (Agent == null || !Agent.enabled) return;\n263\t\n264\t        if (Agent.isOnNavMesh) Agent.ResetPath();\n265\t\n266\t        Agent.updateRotation = false;\n267\t        Agent.isStopped = true;\n268\t    }\n269\t\n270\t    /* 恢复 Agent 的常规控制 */\n271\t    private void ResumeAgentMovement()\n272\t    {\n273\t        var Agent = stateMachine.EnemyRef.AIController?.Agent;\n274\t        if (Agent == null || !Agent.enabled) return;\n275\t\n276\t        /* 受击期间位置被推走了，恢复寻路之前必须先把 Agent 同步到新位置，\n277\t           否则它会按旧位置把敌人拉回受击前的地方 */\n278\t        WarpAgentToCurrentPosition();\n279\t\n280\t        Agent.isStopped = false;\n281\t        Agent.updateRotation = true;\n282\t    }\n283\t\n284\t    /* 把 Agent 瞬移到敌人当前所在的导航网格点。Warp 是唯一安全的外部改位方式，\n285\t       直接写 transform 会让 Agent 内部位置与 transform 不一致 */\n286\t    private void WarpAgentToCurrentPosition()\n287\t    {\n288\t        var Agent = stateMachine.EnemyRef.AIController?.Agent;\n289\t        if (Agent == null || !Agent.enabled || !Agent.isOnNavMesh) return;\n290\t\n291\t        if (!UnityEngine.AI.NavMesh.SamplePosition(stateMachine.EnemyRef.transform.position, out UnityEngine.AI.NavMeshHit Hit, 1f, NavMesh.AllAreas)) return;\n292\t\n293\t        Agent.Warp(Hit.position);\n294\t    }\n295\t\n296\t    private Rigidbody GetRigidBody()\n297\t    {\n298\t        if (bHasCachedRigidBody) return CachedRigidBody;\n299\t\n300\t        CachedRigidBody = stateMachine.EnemyRef.GetComponent<Rigidbody>();\n301\t        bHasCachedRigidBody = true;\n302\t\n303\t        return CachedRigidBody;\n304\t    }\n305\t\n306\t    /* 还原受击期间对刚体做的改动，避免影响之后 Agent 驱动的常规移动 */\n307\t    private void RestoreRigidBody()\n308\t    {\n309\t        Rigidbody Body = GetRigidBody();\n310\t        if (Body == null) return;\n311\t\n312\t        Body.velocity = Vector3.zero;\n313\t        Body.angularVelocity = Vector3.zero;\n314\t        Body.useGravity = CachedUseGravity;\n315\t\n316\t        if (bRestoredRigidBodyKinematic)\n317\t        {\n318\t            Body.isKinematic = true;\n319\t            bRestoredRigidBodyKinematic = false;\n320\t        }\n321\t    }\n322\t\n323\t    public void SetExecutorRef(CommonActor Executor)\n324\t    {\n325\t        if (Executor == null) return;\n326\t        ExecutorRef = Executor;\n327\t    }\n328\t}\n329"
