peSpeedModifiderOnAngle(GroundAngle);\n60\t\n61\t            if (ResultSpeedModifider == 0f) return;\n62\t            \n63\t            //胶囊体高度减去射线距离 \n64\t            //ColliderCenterInLocalSpace.y和 localScale.y相乘是为了将碰撞体中心在本地空间中的高度转换成世界空间中的实际高度\n65\t            float DistanceToFloatingPoint = \n66\t                stateMachine.playerRef.ColliderUtility.capsuleColliderData.ColliderCenterInLocalSpace.y *\n67\t                stateMachine.playerRef.transform.localScale.y - hit.distance;\n68\t\n69\t            if (DistanceToFloatingPoint == 0f) return; //说明胶囊体底部正好在地面\n70\t\n71\t            //需要减去GetPlayerVerticalVelocity().y防止出现刚体自身的力同时施加\n72\t            float AmountToLift = DistanceToFloatingPoint * slopeData.StepReachForce - GetPlayerVerticalVelocity().y; //漂浮多少\n73\t            \n74\t            Vector3 LiftAmount = new Vector3(0f,  AmountToLift, 0f);\n75\t            \n76\t            stateMachine.playerRef.RigidBody.AddForce(LiftAmount, ForceMode.VelocityChange);\n77\t        }\n78\t    }\n79\t\n80\t    private float SetSlopeSpeedModifiderOnAngle(float Angle)\n81\t    {\n82\t        float ResultSlopeSpeedModifider = MovementData.SlopeSpeedAngle.Evaluate(Angle);\n83\t        stateMachine.ReusableData.MovementOnSlopeSpeedModifier = ResultSlopeSpeedModifider;\n84\t\n85\t        return ResultSlopeSpeedModifider;\n86\t    }\n87\t\n88\t    protected override void AddInputActionsCallback()\n89\t    {\n90\t        base.AddInputActionsCallback();\n91\t\n92\t        //当移动按钮松开时\n93\t        stateMachine.playerRef.playerInput.PlayerActions.Movement.canceled += OnMovementCanceled;\n94\t        \n95\t        //翻滚\n96\t        stateMachine.playerRef.playerInput.PlayerActions.Dash.started += OnRollingStarted;\n97\t    }\n98\t\n99\t\n100\t\n101\t    protected override void RemoveInputActionsCallback()\n102\t    {\n103\t        base.RemoveInputActionsCallback();\n104\t        \n105\t        stateMachine.playerRef.playerInput.PlayerActions.Movement.canceled -= OnMovementCanceled;\n106\t        \n107\t        stateMachine.playerRef.playerInput.PlayerActions.Dash.started -= OnRollingStarted;\n108\t    }\n109\t    \n110\t    protected virtual void OnMove()\n111\t    {\n112\t        if (stateMachine.ReusableData.bShouldWalk) //走路状态\n113\t        {\n114\t            stateMachine.ChangeState(stateMachine.WalkingState);\n115\t            return;\n116\t        }\n117\t        \n118\t        stateMachine.ChangeState(stateMachine.RunningState); \n119\t    }\n120\t    \n121\t    /* 通用切换Idle状态 */\n122\t    protected virtual void OnMovementCanceled(InputAction.CallbackContext context)\n123\t    {\n124\t        stateMachine.ChangeState(stateMachine.IdleState);\n125\t    }\n126\t    \n127\t    protected virtual void OnRollingStarted(InputAction.CallbackContext context)\n128\t    {\n129\t        stateMachine.ChangeState(stateMachine.RollingState);\n130\t    }\n131\t}\n132"
