te);\n286\t    }\n287\t\n288\t    #region AI控制器函数\n289\t\n290\t    private IEnumerator AISightCheck()\n291\t    {\n292\t        while (true)\n293\t        {\n294\t            Transform target = AIController.AISight.GetPlayerInSight(\n295\t                transform,\n296\t                CommonSO.GroundedData.sightRange,\n297\t                CommonSO.GroundedData.sightAngle,\n298\t                CommonSO.GroundedData.obstacleMask\n299\t                );\n300\t\n301\t            if (target != null)\n302\t            {\n303\t                CommonSO.GroundedData.CachedPlayerTransform = target;\n304\t                AIController.SetSightBlackBoardValue(\"Idle\", false);\n305\t                AIController.SetSightBlackBoardValue(\"ChasePlayer\");\n306\t            }\n307\t            else\n308\t            {\n309\t                CommonSO.GroundedData.CachedPlayerTransform = null;\n310\t                AIController.SetSightBlackBoardValue(\"ChasePlayer\", false);\n311\t                AIController.SetSightBlackBoardValue(\"Idle\");\n312\t            }\n313\t\n314\t            yield return new WaitForSeconds(0.5f);\n315\t        }\n316\t    }\n317\t\n318\t    #endregion\n319\t    \n320\t}\n321"
