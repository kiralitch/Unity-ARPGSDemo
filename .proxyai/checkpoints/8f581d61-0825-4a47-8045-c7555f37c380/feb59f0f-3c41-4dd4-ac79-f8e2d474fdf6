                    "text": "1\tusing System.Collections;\n2\tusing System.Collections.Generic;\n3\tusing UnityEngine;\n4\tusing UnityEngine.AI;\n5\t\n6\tpublic class Enemy_AttackState : Enemy_CombatCommonState\n7\t{\n8\t    /* 本次攻击使用的技能数据，由 Enemy 在切换状态前赋值 */\n9\t    public EnemyAbilityData CachedAbilityData;\n10\t\n11\t    /* 进入攻击时锁定的玩家位置（世界坐标），之后不再跟随玩家移动 */\n12\t    private Vector3 LockedPlayerPosition;\n13\t\n14\t    /* 是否成功锁定了玩家位置，没锁到就不做旋转 */\n15\t    private bool bHasLockedTarget;\n16\t\n17\t    /* 锁定的朝向（已去掉 y 轴的水平方向） */\n18\t    private Vector3 LockedAttackDirection;\n19\t\n20\t    /* 攻击前旋转的耗时 */\n21\t    private float AttackRotationReachTime = 0.15f;\n22\t\n23\t    /* 已经结束攻击，避免同一段动画的过渡帧事件重复触发收尾逻辑 */\n24\t    private bool bAttackEnded;\n25\t\n26\t    public Enemy_AttackState(Enemy_MovementStateMachine movementStateMachine, Enemy_CombatStateMachine combatStateMachine) : base(movementStateMachine, combatStateMachine)\n27\t    {\n28\t        AttackRotationReachTime = combatStateMachine.EnemyRef.CommonSO.GroundedData.AttackRotationReachTime;\n29\t    }\n30\t\n31\t    #region Main\n32\t\n33\t    public override void Enter()\n34\t    {\n35\t        base.Enter();\n36\t\n37\t        bAttackEnded = false;\n38\t\n39\t        StopAgentForAttack();\n40\t        LockPlayerPositionOnAttack();\n41\t        PlayAttackAnimation();\n42\t    }\n43\t\n44\t    public override void PhysicsUpdate()\n45\t    {\n46\t        base.PhysicsUpdate();\n47\t        \n48\t        RotateToLockedPosition();\n49\t    }\n50\t\n51\t    public override void Exit()\n52\t    {\n53\t        base.Exit();\n54\t\n55\t        bHasLockedTarget = false;\n56\t        bAttackEnded = false;\n57\t        CachedEnemy.ResetRotationVelocity(); //清掉角速度，避免下一次攻击起步抖动\n58\t        ResumeAgentAfterAttack();\n59\t    }\n60\t\n61\t    /* 攻击期间停住 NavMeshAgent：否则 Agent 的转向和 RotateTowards 会同时写 transform.rotation，\n62\t       两个角速度叠加会让敌人抖动，而且 Agent 补间的位置更新会和攻击位移冲突 */\n63\t    private void StopAgentForAttack()\n64\t    {\n65\t        if (CachedEnemy.AIController == null) return;\n66\t\n67\t        NavMeshAgent Agent = CachedEnemy.AIController.Agent;\n68\t        if (Agent == null || !Agent.enabled) return;\n69\t\n70\t        if (Agent.isOnNavMesh) Agent.ResetPath();\n71\t\n72\t        Agent.updateRotation = false; //朝向交给 RotateTowards 单独控制\n73\t        Agent.isStopped = true;\n74\t    }\n75\t\n76\t    /* 恢复 Agent 的常规控制，攻击结束由移动状态接管移动与转向 */\n77\t    private void ResumeAgentAfterAttack()\n78\t    {\n79\t        if (CachedEnemy.AIController == null) return;\n80\t\n81\t        NavMeshAgent Agent = CachedEnemy.AIController.Agent;\n82\t        if (Agent == null || !Agent.enabled) return;\n83\t\n84\t        Agent.isStopped = false;\n85\t        Agent.updateRotation = true;\n86\t    }\n87\t\n88\t    /* 播放本次技能的第一段连招，并把技能伤害写入碰撞箱 */\n89\t    private void PlayAttackAnimation()\n90\t    {\n91\t        if (CachedAbilityData == null)\n92\t        {\n93\t            Debug.LogError(\"进入攻击状态但没有技能数据，无法播放连招动画！\");\n94\t            return;\n95\t        }\n96\t\n97\t        CachedClipsData.PlayEnemyComboClip(\n98\t            CachedAbilityData,\n99\t            CachedEnemy.AnimationGraph\n100\t            );\n101\t\n102\t        CachedEnemy.HitBoxUtils.SetCachedDamage(CachedClipsData.GetEnemyAbilityDamage());\n103\t    }\n104\t\n105\t    /* 攻击前获取玩家位置：这里记录的是进入攻击瞬间的位置，玩家之后移动不会改变本次攻击的朝向 */\n106\t    private void LockPlayerPositionOnAttack()\n107\t    {\n108\t        bHasLockedTarget = false;\n109\t        LockedAttackDirection = Vector3.zero;\n110\t\n111\t        if (CachedEnemy.AIController == null) return;\n112\t        if (!CachedEnemy.AIController.TryGetPlayerPosition(out LockedPlayerPosition)) return;\n113\t\n114\t        Vector3 Direction = LockedPlayerPosition - CachedEnemy.transform.position;\n115\t        Direction.y = 0f;\n116\t\n117\t        //敌人与玩家位置重合时没有有效朝向，直接跳过旋转\n118\t        if (Direction.sqrMagnitude < 0.0001f) return;\n119\t\n120\t        LockedAttackDirection = Direction.normalized;\n121\t        bHasLockedTarget = true;\n122\t    }\n123\t\n124\t    /* 每帧朝锁定的位置平滑旋转，直到朝向玩家为止 */\n125\t    private void RotateToLockedPosition()\n126\t    {\n127\t        if (!bHasLockedTarget) return;\n128\t\n129\t        CachedEnemy.RotateTowards(LockedAttackDirection, AttackRotationReachTime);\n130\t    }\n131\t\n132\t    /* 当前是否已经大致朝向锁定的玩家位置 */\n133\t    public bool IsFacingLockedTarget()\n134\t    {\n135\t        if (!bHasLockedTarget) return true;\n136\t\n137\t        return Vector3.Angle(CachedEnemy.RotationTransform.forward, LockedAttackDirection) <= 5f;\n138\t    }\n139\t\n140\t    public override void OnAnimatationEnterEvent()\n141\t    {\n142\t        base.OnAnimatationEnterEvent();\n143\t        \n144\t        CombatStateMachine.EnemyRef.HitBoxUtils.EnableHitBox();\n145\t    }\n146\t\n147\t    public override void OnAnimatationExitEvent()\n148\t    {\n149\t        base.OnAnimatationExitEvent();\n150\t        \n151\t        CombatStateMachine.EnemyRef.HitBoxUtils.DisableHitBox();\n152\t    }\n153\t\n154\t    /* 连招段落上的过渡帧触发：还有下一段就接着播，已经是最后一段就退出攻击\n155\t     * 注意：这个事件来自攻击动画，不是移动状态机的事件 */\n156\t    public override void OnAnimationTransitionEvent()\n157\t    {\n158\t        base.OnAnimationTransitionEvent();\n159\t\n160\t        //已经收尾过就不再响应，避免同一段动画的事件重复触发收尾逻辑\n161\t        if (bAttackEnded) return;\n162\t\n163\t        if (!CachedClipsData.PlayNextEnemyComboClip(CachedEnemy.AnimationGraph))\n164\t        {\n165\t            bAttackEnded = true;\n166\t            EndAttack();\n167\t        }\n168\t    }\n169\t\n170\t    /* 连招播完，收尾并交还控制权 */\n171\t    private void EndAttack()\n172\t    {\n173\t        CachedEnemy.ResetRotationVelocity();\n174\t        CachedEnemy.OnAttackFinished();\n175\t    }\n176\t\n177\t    #endregion\n178\t}\n179"
