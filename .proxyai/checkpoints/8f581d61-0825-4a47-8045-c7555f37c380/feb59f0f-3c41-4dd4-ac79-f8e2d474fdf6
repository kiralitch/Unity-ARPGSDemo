                    "text": "1\tusing System.Collections;\n2\tusing System.Collections.Generic;\n3\tusing UnityEngine;\n4\t\n5\tpublic class Enemy_HitReact : Enemy_GroundedState\n6\t{\n7\t    private CommonActor ExecutorRef;\n8\t\n9\t    /* 本次受击锁定下来的后退方向与朝向（受击瞬间决定，之后不再跟着攻击者变） */\n10\t    private Vector3 HitBackDirection;\n11\t    private Vector3 FacingDirection;\n12\t\n13\t    /* 受击瞬间记录的攻击者位置 */\n14\t    private Vector3 LockedExecutorPosition;\n15\t\n16\t    private bool bHasLockedTarget = false;\n17\t\n18\t    /* 后退位移已经完成，不再做任何表现控制 */\n19\t    private bool bKnockbackFinished = false;\n20\t\n21\t    /* 后退剩余的位移量（米）与剩余时间，用来推进速度曲线 */\n22\t    private float RemainingKnockbackDistance;\n23\t    private float RemainingKnockbackTime;\n24\t\n25\t    private Rigidbody CachedRigidBody;\n26\t    private bool bHasCachedRigidBody;\n27\t\n28\t    /* 是否有一根受击期间被我们改成非 kinematic 的刚体需要在退出时还原 */\n29\t    private bool bRestoredRigidBodyKinematic;\n30\t\n31\t    /* 后退期间刚体原来的重力设置，退出时还原 */\n32\t    private bool CachedUseGravity;\n33\t\n34\t    /* 受击期间由代码直接改过 transform，需要在下一次写位置前把偏差吃进忽略量，\n35\t       否则物理引擎的插值会把我们写进去的位移再补一遍 */\n36\t    private Vector3 IgnoredPositionDelta = Vector3.zero;\n37\t\n38\t    private Enemy_GroundData GroundedData => stateMachine.EnemyRef.CommonSO.GroundedData;\n39\t\n40\t    public Enemy_HitReact(Enemy_MovementStateMachine StateMachineRef) : base(StateMachineRef)\n41\t    {\n42\t\n43\t    }\n44\t\n45\t    public override void Enter()\n46\t    {\n47\t        base.Enter();\n48\t\n49\t        /* 受击期间不再追击/攻击，这里停掉 Agent，否则受击动画会推着敌人继续滑向玩家。\n50\t           Agent 停住之后它也就不会再写 transform，位置可以安全地交给受击位移控制 */\n51\t        StopAgentMovement();\n52\t        CheckPlayerPositon();\n53\t\n54\t        stateMachine.EnemyRef.AnimationClipData.ResetCommonReactionAnimationTime(0);\n55\t        stateMachine.EnemyRef.AnimationClipData.SetCommonReacitonTarget(0);\n56\t        stateMachine.EnemyRef.AnimationClipData.SetRootTarget(0, 0, 1);\n57\t    }\n58\t\n59\t    /* 受击瞬间锁定后退方向与朝向，并把后退量算成初速度交给刚体 */\n60\t    private void CheckPlayerPositon()\n61\t    {\n62\t        bHasLockedTarget = false;\n63\t        bKnockbackFinished = false;\n64\t\n65\t        HitBackDirection = Vector3.zero;\n66\t        FacingDirection = Vector3.zero;\n67\t        RemainingKnockbackDistance = 0f;\n68\t        RemainingKnockbackTime = 0f;\n69\t\n70\t        if (ExecutorRef == null) return;\n71\t\n72\t        LockedExecutorPosition = ExecutorRef.transform.position;\n73\t\n74\t        Vector3 BackDir = stateMachine.EnemyRef.transform.position - LockedExecutorPosition;\n75\t        BackDir.y = 0f;\n76\t\n77\t        /* 敌人与攻击者位置完全重合时没有有效的后退方向，\n78\t           此时只做朝向，不做位移，避免沿 NaN 方向把敌人推飞 */\n79\t        if (BackDir.sqrMagnitude < 0.0001f)\n80\t        {\n81\t            Debug.LogWarning($\"{stateMachine.EnemyRef.name} 与攻击者 {ExecutorRef.name} 位置重合，本次受击不产生后退位移\");\n82\t            return;\n83\t        }\n84\t\n85\t        HitBackDirection = BackDir.normalized;\n86\t\n87\t        /* 正对着攻击者，也就是背对着后退方向 */\n88\t        FacingDirection = -HitBackDirection;\n89\t\n90\t        bHasLockedTarget = true;\n91\t\n92\t        RemainingKnockbackDistance = GroundedData.HitKnockbackDistance;\n93\t        RemainingKnockbackTime = GroundedData.HitKnockbackDuration;\n94\t\n95\t        TryStartRigidbodyKnockback();\n96\t    }\n97\t\n98\t    #region 刚体后退\n99\t\n100\t    /* 受击后退优先交给刚体：敌人平时是 kinematic，完全由 Agent 写位置，\n101\t       这里临时解除 kinematic 才能用速度推动。解除时用上一物理帧的插值位置回写，\n102\t       避免物理引擎把插值位置当成真实位置后让敌人瞬移回受击前的位置 */\n103\t    private void TryStartRigidbodyKnockback()\n104\t    {\n105\t        if (!GroundedData.bUseRigidbodyKnockback) return;\n106\t\n107\t        Rigidbody Body = GetRigidBody();\n108\t        if (Body == null || !Body.enabled) return;\n109\t\n110\t        CachedUseGravity = Body.useGravity;\n111\t\n112\t        if (Body.isKinematic)\n113\t        {\n114\t            Body.isKinematic = false;\n115\t            bRestoredRigidBodyKinematic = true;\n116\t        }\n117\t\n118\t        /* 受击期间不要重力：敌人高度由地面贴合逻辑负责，\n119\t           交给重力会让胶囊体缓慢下沉到地面以下 */\n120\t        Body.useGravity = false;\n121\t\n122\t        /* 清掉残留速度，保证后退初速度完全由本次受击决定 */\n123\t        Body.velocity = Vector3.zero;\n124\t        Body.angularVelocity = Vector3.zero;\n125\t\n126\t        Body.AddForce(HitBackDirection * GroundedData.HitKnockbackSpeed, ForceMode.VelocityChange);\n127\t\n128\t        Debug.Log($\"{stateMachine.EnemyRef.name} 受击后退：方向 {HitBackDirection}，初速度 {GroundedData.HitKnockbackSpeed}\");\n129\t    }\n130\t\n131\t    /* 刚体后退：每帧施加反向加速度把速度衰减到 0，\n132\t       这样前后两帧速度都由代码给定，实际位移不会被物理解算结果带偏 */\n133\t    private void PhysicsUpdateRigidbodyKnockback()\n134\t    {\n135\t        Rigidbody Body = GetRigidBody();\n136\t        if (Body == null || Body.isKinematic) return;\n137\t\n138\t        Vector3 HorizontalVelocity = Body.velocity;\n139\t        HorizontalVelocity.y = 0f;\n140\t\n141\t        /* 速度方向与后退方向相反说明位移已经超出目标距离（例如被撞墙弹回），\n142\t           继续衰减只会把它推得更远，直接停住 */\n143\t        if (Vector3.Dot(HorizontalVelocity, HitBackDirection) <= 0f)\n144\t        {\n145\t            Body.velocity = Vector3.zero;\n146\t            return;\n147\t        }\n148\t\n149\t        Body.AddForce(-HitBackDirection * GroundedData.HitKnockbackDrag, ForceMode.Acceleration);\n150\t    }\n151\t\n152\t    #endregion\n153\t\n154\t    #region 运动学后退\n155\t\n156\t    /* 刚体被禁用或不允许脱离 kinematic 时的兜底：按「速度曲线 × 时间」逐帧推 transform，\n157\t       推完再用 Agent.Warp 把 NavMesh 上的位置同步过去 */\n158\t    private void UpdateKinematicKnockback(float DeltaTime)\n159\t    {\n160\t        /* Duration 执行过程中被改小（例如 Inspector 里调参）时按当前值收口，\n161\t           避免剩余时间大于总时长导致速度曲线反向 */\n162\t        if (RemainingKnockbackTime > GroundedData.HitKnockbackDuration)\n163\t        {\n164\t            RemainingKnockbackTime = GroundedData.HitKnockbackDuration;\n165\t        }\n166\t\n167\t        float Progress = GroundedData.HitKnockbackDuration - RemainingKnockbackTime;\n168\t        float Speed = GroundedData.HitKnockbackSpeed * (1f - Progress / GroundedData.HitKnockbackDuration);\n169\t        float Step = Mathf.Min(Speed * DeltaTime, RemainingKnockbackDistance);\n170\t\n171\t        if (Step > 0f)\n172\t        {\n173\t            Vector3 NewPosition = stateMachine.EnemyRef.transform.position + HitBackDirection * Step;\n174\t\n175\t            /* 走 NavMesh 采样而不是直接赋位置：墙面和台阶会被挡住，\n176\t               敌人不会因为受击被推进墙里或者掉出导航网格 */\n177\t            if (UnityEngine.AI.NavMesh.SamplePosition(NewPosition, out UnityEngine.AI.NavMeshHit Hit, 0.5f, NavMesh.AllAreas))\n178\t            {\n179\t                NewPosition = Hit.RandomPositionInRadius(Hit.position, HitBackDirection, Step);\n180\t            }\n181\t\n182\t            stateMachine.EnemyRef.transform.position = NewPosition;\n183\t        }\n184\t\n185\t        RemainingKnockbackDistance -= Step;\n186\t        RemainingKnockbackTime -= DeltaTime;\n187\t    }\n188\t\n189\t    /* 把受击期间脱离 NavMesh 的敌人绑回最近的导航网格点 */\n190\t    private void SyncAgentToKnockbackPosition()\n191\t    {\n192\t        var Agent = stateMachine.EnemyRef.AIController?.Agent;\n193\t        if (Agent == null || !Agent.enabled || !Agent.isOnNavMesh) return;\n194\t\n195\t        if (!UnityEngine.AI.NavMesh.SamplePosition(stateMachine.EnemyRef.transform.position, out UnityEngine.AI.NavMeshHit Hit, 1f, NavMesh.AllAreas)) return;\n196\t\n197\t        Agent.Warp(Hit.position);\n198\t    }\n199\t\n200\t    #endregion\n201\t\n202\t    /* 受击状态覆盖基类的 PhysicsUpdate：基类会在玩家进入攻击范围时触发攻击，\n203\t       受击动画播完立刻接一段攻击，表现上就是「每次受击后都打一下」。\n204\t       受击期间完全不参与追击与攻击判定 */\n205\t    public override void PhysicsUpdate()\n206\t    {\n207\t        if (!bHasLockedTarget) return;\n208\t\n209\t        RotateTowardsExecutor();\n210\t\n211\t        UpdateKnockback();\n212\t    }\n213\t\n214\t    /* 每次物理帧都朝受击瞬间锁定的攻击者位置转，转到目标朝向之后不再写旋转 */\n215\t    private void RotateTowardsExecutor()\n216\t    {\n217\t        if (Vector3.Angle(stateMachine.EnemyRef.RotationTransform.forward, FacingDirection) <= 1f) return;\n218\t\n219\t        stateMachine.EnemyRef.RotateTowards(FacingDirection, GroundedData.HitFacingReachTime);\n220\t    }\n221\t\n222\t    private void UpdateKnockback()\n223\t    {\n224\t        if (bKnockbackFinished) return;\n225\t\n226\t        Rigidbody Body = GetRigidBody();\n227\t\n228\t        /* 刚体可用时由物理引擎推进位移，动画只负责姿势 */\n229\t        if (Body != null && !Body.isKinematic)\n230\t        {\n231\t            PhysicsUpdateRigidbodyKnockback();\n232\t            return;\n233\t        }\n234\t\n235\t        if (RemainingKnockbackTime <= 0f) return;\n236\t\n237\t        UpdateKinematicKnockback(Time.fixedDeltaTime);\n238\t\n239\t        if (RemainingKnockbackDistance > 0f && RemainingKnockbackTime > 0f) return;\n240\t\n241\t        bKnockbackFinished = true;\n242\t        SyncAgentToKnockbackPosition();\n243\t    }\n244\t\n245\t    public override void Exit()\n246\t    {\n247\t        base.Exit();\n248\t\n249\t        StopKnockback();\n250\t        ResumeAgentMovement();\n251\t    }\n252\t\n253\t    /* 退出受击：清速度、把刚体恢复成 kinematic 与原来的重力设置，\n254\t       位置交接给 Agent（Warp 到当前位置再恢复寻路，避免恢复控制时弹回受击前的位置） */\n255\t    private void StopKnockback()\n256\t    {\n257\t        RestoreRigidBody();\n258\t\n259\t        bHasLockedTarget = false;\n260\t        bKnockbackFinished = true;\n261\t        RemainingKnockbackDistance = 0f;\n262\t        RemainingKnockbackTime = 0f;\n263\t\n264\t        stateMachine.EnemyRef.ResetRotationVelocity();\n265\t    }\n266\t\n267\t    public override void OnAnimationTransitionEvent()\n268\t    {\n269\t        base.OnAnimationTransitionEvent();\n270\t\n271\t        stateMachine.ChangeState(stateMachine.IdleState);\n272\t    }\n273\t\n274\t    /* 停住 NavMeshAgent，受击位移完全由受击状态与动画负责 */\n275\t    private void StopAgentMovement()\n276\t    {\n277\t        var Agent = stateMachine.EnemyRef.AIController?.Agent;\n278\t        if (Agent == null || !Agent.enabled) return;\n279\t\n280\t        if (Agent.isOnNavMesh) Agent.ResetPath();\n281\t\n282\t        Agent.updateRotation = false;\n283\t        Agent.isStopped = true;\n284\t    }\n285\t\n286\t    /* 恢复 Agent 的常规控制 */\n287\t    private void ResumeAgentMovement()\n288\t    {\n289\t        var Agent = stateMachine.EnemyRef.AIController?.Agent;\n290\t        if (Agent == null || !Agent.enabled) return;\n291\t\n292\t        if (Agent.isOnNavMesh)\n293\t        {\n294\t            /* Warp 会把 Agent 瞬移到指定位置，用它把受击期间被推走的位置写回 Agent，\n295\t               之后再恢复寻路，否则 Agent 会按旧位置把敌人拉回来 */\n296\t            if (UnityEngine.AI.NavMesh.SamplePosition(stateMachine.EnemyRef.transform.position, out UnityEngine.AI.NavMeshHit Hit, 1f, NavMesh.AllAreas))\n297\t            {\n298\t                Agent.Warp(Hit.position);\n299\t            }\n300\t        }\n301\t\n302\t        Agent.isStopped = false;\n303\t        Agent.updateRotation = true;\n304\t    }\n305\t\n306\t    private Rigidbody GetRigidBody()\n307\t    {\n308\t        if (bHasCachedRigidBody) return CachedRigidBody;\n309\t\n310\t        CachedRigidBody = stateMachine.EnemyRef.GetComponent<Rigidbody>();\n311\t        bHasCachedRigidBody = true;\n312\t\n313\t        return CachedRigidBody;\n314\t    }\n315\t\n316\t    /* 还原受击期间对刚体做的改动，避免影响之后 Agent 驱动的常规移动 */\n317\t    private void RestoreRigidBody()\n318\t    {\n319\t        Rigidbody Body = GetRigidBody();\n320\t        if (Body == null) return;\n321\t\n322\t        Body.velocity = Vector3.zero;\n323\t        Body.angularVelocity = Vector3.zero;\n324\t        Body.useGravity = CachedUseGravity;\n325\t\n326\t        if (bRestoredRigidBodyKinematic)\n327\t        {\n328\t            Body.isKinematic = true;\n329\t            bRestoredRigidBodyKinematic = false;\n330\t        }\n331\t    }\n332\t\n333\t    public void SetExecutorRef(CommonActor Executor)\n334\t    {\n335\t        if (Executor == null) return;\n336\t        ExecutorRef = Executor;\n337\t    }\n338\t}\n339"
