                    "text": "1\tusing UnityEngine;\n2\tusing UnityEngine.Animations;\n3\tusing UnityEngine.InputSystem;\n4\tusing UnityEngine.Playables;\n5\t\n6\t/*\n7\t * 玩家移动状态\n8\t * \n9\t */\n10\t\n11\tpublic class Player_MovementStates : IState\n12\t{\n13\t    protected Player_MovementStateMachine stateMachine;\n14\t    \n15\t    //移动资产\n16\t    protected Player_GroundedData MovementData;\n17\t    \n18\t    public Player_MovementStates(Player_MovementStateMachine playerMovementStateMachine)\n19\t    {\n20\t        stateMachine = playerMovementStateMachine;\n21\t        MovementData = stateMachine.playerRef.AssetData.GroundedData;\n22\t        \n23\t        InitData();\n24\t    }\n25\t\n26\t    private void InitData()\n27\t    {\n28\t        stateMachine.ReusableData.TimeToReachTargetRotation = MovementData.RotationData.TargetRotationReachTime;\n29\t    }\n30\t\n31\t    public virtual void Enter()\n32\t    {\n33\t        Debug.Log(\"State\" + GetType().Name);\n34\t\n35\t        stateMachine.playerRef.AnimationClipData.SetRootTarget(1, 0, 0);\n36\t        AddInputActionsCallback();\n37\t        //stateMachine.playerRef.AnimationClipData.ResetAttackAnimationTime(0);\n38\t        //stateMachine.playerRef.AnimationClipData.ResetAttackAnimationTime(1);\n39\t    }\n40\t    \n41\t    public virtual void Exit()\n42\t    {\n43\t        RemoveInputActionsCallback();\n44\t    }\n45\t\n46\t    public virtual void HandleInput()\n47\t    {\n48\t        ReadPlayerMovementInput();\n49\t    }\n50\t\n51\t    public virtual void Update()\n52\t    {\n53\t        \n54\t    }\n55\t\n56\t    public virtual void PhysicsUpdate() //FixUpdate() 在Update()之后执行\n57\t    {\n58\t        Move();\n59\t        \n60\t    }\n61\t\n62\t    public virtual void OnAnimatationEnterEvent()\n63\t    {\n64\t       \n65\t    }\n66\t\n67\t    public virtual void OnAnimatationExitEvent()\n68\t    {\n69\t        \n70\t    }\n71\t\n72\t    public virtual void OnAnimationTransitionEvent()\n73\t    {\n74\t        \n75\t    }\n76\t\n77\t    #region 主方法\n78\t    /* 读取玩家输入 */\n79\t    private void ReadPlayerMovementInput()\n80\t    {\n81\t        //从PlayerAction里面直接读取玩家是否由按键\n82\t        stateMachine.ReusableData.MovementInput = stateMachine.playerRef.playerInput.PlayerActions.Movement.ReadValue<Vector2>();\n83\t    }\n84\t    \n85\t    private void Move()\n86\t    {\n87\t        if(stateMachine.ReusableData.MovementInput == Vector2.zero || stateMachine.ReusableData.MovementSpeedModifier == 0f) return; //如果玩家输入为0，则不移动\n88\t        if(stateMachine.playerRef.CurrentStateMode == PlayStateMode.Combat) return;\n89\t        \n90\t        stateMachine.playerRef.AnimationClipData.SetRootTarget(1f, 0f, 0f);\n91\t        \n92\t        Vector3 MovementDirection = GetMovementInputDirection();\n93\t\n94\t        float targetRotationYAngle = Rotate(MovementDirection);\n95\t\n96\t        Vector3 targetRotationDirection = GetTargetRotationDirection(targetRotationYAngle);\n97\t\n98\t        float Speed = GetSpeedMovement();\n99\t        \n100\t        //注意：AddForce方法是在刚体原有的力加上新的力，所以要减去原有的速度\n101\t        Vector3 currentPlayerHorizontalVel = GetPlayerHorizontalVelocity(); //获取刚体原有的速度\n102\t        \n103\t        stateMachine.playerRef.RigidBody.AddForce(\n104\t            targetRotationDirection * Speed - currentPlayerHorizontalVel,\n105\t            ForceMode.VelocityChange\n106\t            );\n107\t    }\n108\t\n109\t    /* 根据给定的方向向量，计算出角色在 Y 轴上应该旋转到的目标角度 */\n110\t    private float Rotate(Vector3 Direction)\n111\t    {\n112\t        float direciontAngle = UpdateTargetRotation(Direction);\n113\t\n114\t        RotateTowardTargerRoatation();\n115\t        \n116\t        return direciontAngle;\n117\t    }\n118\t    #endregion\n119\t    \n120\t    /* 可重写 */\n121\t    /* 设置根动画输入权重 */\n122\t    protected void SetAnimationInputWeight(PlayableType CurrentStateType, int AnimatinoIndex, float weight)\n123\t    {\n124\t        var animData = stateMachine.playerRef.AnimationClipData;\n125\t        if (CurrentStateType == PlayableType.Movement)\n126\t        {\n127\t            animData.SetMovementTarget(AnimatinoIndex, weight);\n128\t            animData.SetRootTarget(1f, 0f, 0f);\n129\t        }\n130\t    }\n131\t\n132\t    protected Vector3 GetMovementInputDirection()\n133\t    {\n134\t        return new Vector3(stateMachine.ReusableData.MovementInput.x, 0f, stateMachine.ReusableData.MovementInput.y);\n135\t    }\n136\t\n137\t    protected float GetSpeedMovement()\n138\t    {\n139\t        return MovementData.BaseSpeed * stateMachine.ReusableData.MovementSpeedModifier * stateMachine.ReusableData.MovementOnSlopeSpeedModifier;\n140\t    }\n141\t    \n142\t    protected Vector3 GetPlayerHorizontalVelocity()\n143\t    {\n144\t        Vector3 PlayerHorizontalVel = stateMachine.playerRef.RigidBody.velocity;\n145\t        PlayerHorizontalVel.y = 0f;\n146\t        return PlayerHorizontalVel;\n147\t    }\n148\t\n149\t    protected float GetDirectionAngle(Vector3 direction)\n150\t    {\n151\t        float direciontAngle = Mathf.Atan2(direction.x, direction.z) * Mathf.Rad2Deg;\n152\t        if (direciontAngle < 0f) direciontAngle += 360f; //若是-90，则变成270\n153\t        \n154\t        return direciontAngle;\n155\t    }\n156\t\n157\t    /* 添加摄像机角度 比如角色90°往右走时摄像机也往右90°最后角色会变成180°旋转 */\n158\t    protected float AddCameraRotationToAngle(float angle)\n159\t    {\n160\t        //将摄像机的 Y 轴旋转角度叠加到计算出的相对角度上，得到世界空间中的目标绝对角度\n161\t        angle += stateMachine.playerRef.MainCameraTransform.eulerAngles.y;\n162\t        if (angle > 360f) angle -= 360f; //600会返回240\n163\t\n164\t        return angle;\n165\t    }\n166\t    \n167\t    //将刚体朝向选装到摄像机角度\n168\t   protected void RotateTowardTargerRoatation()\n169\t   {\n170\t       //当前角色朝向角度\n171\t       float currentYAngle = stateMachine.playerRef.RigidBody.rotation.eulerAngles.y;\n172\t\n173\t       if (currentYAngle == stateMachine.ReusableData.CurrentTargetRotatino.y) return;\n174\t\n175\t       //平滑旋转角度\n176\t       float SmoothYAngle = Mathf.SmoothDampAngle(\n177\t           currentYAngle,\n178\t           stateMachine.ReusableData.CurrentTargetRotatino.y,\n179\t           ref stateMachine.ReusableData.DampedTargetRotationCurrentVelocity.y,\n180\t           stateMachine.ReusableData.TimeToReachTargetRotation.y - stateMachine.ReusableData.DampedTargetRotationPassedTime.y\n181\t           );\n182\t\n183\t       stateMachine.ReusableData.DampedTargetRotationPassedTime.y += Time.deltaTime;\n184\t\n185\t       Quaternion targetRotation = Quaternion.Euler(0f, SmoothYAngle, 0f);\n186\t       \n187\t       stateMachine.playerRef.RigidBody.MoveRotation(targetRotation);\n188\t   }\n189\t   \n190\t   private void UpdateTargetRotationData(float targetAngle)\n191\t   {\n192\t       stateMachine.ReusableData.CurrentTargetRotatino.y = targetAngle;\n193\t       stateMachine.ReusableData.DampedTargetRotationPassedTime.y = 0f; //重置已过去时间\n194\t   }\n195\t\n196\t   /* 更新目标旋转值 */\n197\t   protected float UpdateTargetRotation(Vector3 Direction, bool bShouldConsiderCameraRoation = true)\n198\t   {\n199\t       float direciontAngle = GetDirectionAngle(Direction);\n200\t\n201\t       if (bShouldConsiderCameraRoation)\n202\t       {\n203\t           direciontAngle = AddCameraRotationToAngle(direciontAngle);\n204\t       }\n205\t\n206\t       if (direciontAngle != stateMachine.ReusableData.CurrentTargetRotatino.y)\n207\t       {\n208\t           UpdateTargetRotationData(direciontAngle);\n209\t       }\n210\t\n211\t       return direciontAngle;\n212\t   }\n213\t   \n214\t   protected Vector3 GetTargetRotationDirection(float TargetAngle)\n215\t   {\n216\t       return Quaternion.Euler(0f, TargetAngle, 0f) * Vector3.forward;\n217\t   }\n218\t\n219\t   /* 直接设置为0,防止出现停止后滑行 */\n220\t   protected void ResetVelocity()\n221\t   {\n222\t       stateMachine.playerRef.RigidBody.velocity = Vector3.zero;\n223\t   }\n224\t\n225\t   protected Vector3 GetPlayerVerticalVelocity()\n226\t   {\n227\t       return new Vector3(0f, stateMachine.playerRef.RigidBody.velocity.y, 0f);\n228\t   }\n229\t   /* 玩家水平方向减速 */\n230\t   protected void DecelerateHorizontally()\n231\t   {\n232\t       Vector3 HorizontalVel = GetPlayerHorizontalVelocity();\n233\t       stateMachine.playerRef.RigidBody.AddForce(-HorizontalVel * stateMachine.ReusableData.MovementDecelerattionForce, ForceMode.Acceleration);\n234\t   }\n235\t\n236\t   /* 通过对比玩家水平上速度的向量长度来判断是否在移动中（大于这个值就是正在移动） */\n237\t   protected bool IsMovingHorizontally(float limiter = 0.1f)\n238\t   {\n239\t       Vector2 PlayerHorizontalMovement = new Vector2(\n240\t           GetPlayerHorizontalVelocity().x,\n241\t           GetPlayerHorizontalVelocity().z\n242\t           );\n243\t\n244\t       return PlayerHorizontalMovement.magnitude > limiter;\n245\t   }\n246\t\n247\t   #region 输入函数\n248\t   /* 输入回调函数 */\n249\t   protected virtual void AddInputActionsCallback()\n250\t   {\n251\t       //绑定回调函数\n252\t       stateMachine.playerRef.playerInput.PlayerActions.WalkToggle.started += OnWalkToggleStarted;\n253\t   }\n254\t\n255\t   protected virtual void RemoveInputActionsCallback()\n256\t   {\n257\t       //解绑\n258\t       stateMachine.playerRef.playerInput.PlayerActions.WalkToggle.started -= OnWalkToggleStarted;\n259\t   }\n260\t   \n261\t   /* 切换走路 */\n262\t   protected virtual void OnWalkToggleStarted(InputAction.CallbackContext context)\n263\t   {\n264\t       stateMachine.ReusableData.bShouldWalk = !stateMachine.ReusableData.bShouldWalk;\n265\t   }\n266\t   \n267\t   #endregion\n268\t}\n269"
