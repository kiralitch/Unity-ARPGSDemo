,\n155\t                1f - Mathf.Exp(-blendSpeed * deltaTime)\n156\t                ));\n157\t        }\n158\t\n159\t        // 更新根混合器\n160\t        float currentMove = RootMixer.GetInputWeight(0);\n161\t        float currentAttack = RootMixer.GetInputWeight(1);\n162\t        float CurrentCommonReacation = RootMixer.GetInputWeight(2);\n163\t        RootMixer.SetInputWeight(0, Mathf.Lerp(currentMove, targetMoveWeight, 1f - Mathf.Exp(-blendSpeed * deltaTime)));\n164\t        RootMixer.SetInputWeight(1, Mathf.Lerp(currentAttack, targetAttackWeight, 1f - Mathf.Exp(-blendSpeed * deltaTime)));\n165\t        RootMixer.SetInputWeight(2, Mathf.Lerp(CurrentCommonReacation, targetCommonReactionWeight, 1f - Mathf.Exp(-blendSpeed * deltaTime)));\n166\t    }\n167\t\n168\t    /* 播放攻击动画\n169\t     * AttackMixer 是权重混合器，端口必须始终保持有效连接，一旦某个端口为空，\n170\t     * 混合结果会退化成绑定姿势（T-pose）。因此这里只重建 Playable 并在同一帧内\n171\t     * 用 Connect 覆盖旧连接（Connect 会自动替换该端口的原有连接），\n172\t     * 绝不先 Disconnect 后再 Connect。*/\n173\t    public void PlayAttackClip(AnimationClip attackClip, AnimationClip EndClip, PlayableGraph graph, float speed = 1f)\n174\t    {\n175\t        if (attackClip == null || EndClip == null) return;\n176\t        if (!AttackMixer.IsValid())\n177\t        {\n178\t            Debug.LogError(\"AttackMixer未初始化！\");\n179\t            return;\n180\t        }\n181\t\n182\t        CachedAttackClipPlayable = CreateAttackPlayable(graph, attackClip, attackInputPort, speed);\n183\t        CachedEndClipPlayable = CreateAttackPlayable(graph, EndClip, attackEndInputPort, speed);\n184\t\n185\t        //两个端口都已持有有效动画后再切换权重\n186\t        AttackMixer.SetInputWeight(attackInputPort, 1f);\n187\t        AttackMixer.SetInputWeight(attackEndInputPort, 0f);\n188\t        SetRootTarget(0f, 1f, 0f); // 切换到攻击权重\n189\t    }\n190\t    \n191\t    /* 播放攻击停止动画\n192\t     * 只做同帧权重交接：先让收招端口拿到权重，再释放攻击端口权重，\n193\t     * 中间不存在端口为空或权重和为 0 的帧 */\n194\t    public void StartAttackEnd(PlayableGraph graph, float speed = 1f)\n195\t    