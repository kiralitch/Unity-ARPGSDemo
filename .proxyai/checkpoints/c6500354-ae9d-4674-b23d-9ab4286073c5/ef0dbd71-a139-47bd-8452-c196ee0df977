le;\n53\t    \n54\t    public PlayableGraph Initialize(Animator animator, PlayableGraph RootGraph)\n55\t    {\n56\t        this.graph = RootGraph;\n57\t        \n58\t        if (!RootGraph.IsValid())\n59\t        {\n60\t            RootGraph = PlayableGraph.Create(\"PlayerAnimationGraph\");\n61\t            RootGraph.SetTimeUpdateMode(DirectorUpdateMode.GameTime);\n62\t        }\n63\t\n64\t        /* 移动动画 */\n65\t        MovementMixer = AnimationMixerPlayable.Create(RootGraph);\n66\t        if (MovementClips == null || MovementClips.Count == 0)\n67\t        {\n68\t            Debug.LogError(\"移动动画列表为空，无法初始化动画图！\");\n69\t            return RootGraph;\n70\t        }\n71\t\n72\t        foreach (var clip in MovementClips)\n73\t        {\n74\t            var clipPlayable = AnimationClipPlayable.Create(RootGraph, clip);\n75\t            MovementMixer.AddInput(clipPlayable, 0, 0f);\n76\t        }\n77\t        \n78\t        movementTargets = new float[MovementMixer.GetInputCount()];\n79\t        movementTargets[0] = 1f; // 默认激活第一个动画\n80\t        \n81\t        /* 通用动画 */\n82\t        CommonReactionMixer = AnimationMixerPlayable.Create(RootGraph);\n83\t        //先受击动画后死亡动画\n84\t        if (HitReactionClips != null)\n85\t        {\n86\t            foreach (var clip in HitReactionClips)\n87\t            {\n88\t                var HitPlayable = AnimationClipPlayable.Create(RootGraph, clip);\n89\t                CommonReactionMixer.AddInput(HitPlayable, 0, 0f);\n90\t            }\n91\t        }\n92\t\n93\t        if (DeathClips != null)\n94\t        {\n95\t            foreach (var clip in DeathClips)\n96\t            {\n97\t                var HitPlayable = AnimationClipPlayable.Create(RootGraph, clip);\n98\t                CommonReactionMixer.AddInput(HitPlayable, 0, 0f);\n99\t            }\n100\t        }\n101\t\n102\t        CommonReactionTargets = new float[CommonReactionMixer.GetInputCount()];\n103\t        if (CommonReactionTargets.Length > 0) CommonReactionTargets[0] = 1f;