le;\n53\t    \n54\t    public PlayableGraph Initialize(Animator animator, PlayableGraph RootGraph)\n55\t    {\n56\t        this.graph = RootGraph;\n57\t        \n58\t        if (!RootGraph.IsValid())\n59\t        {\n60\t            RootGraph = PlayableGraph.Create(\"PlayerAnimationGraph\");\n61\t            RootGraph.SetTimeUpdateMode(DirectorUpdateMode.GameTime);\n62\t        }\n63\t\n64\t        /* 移动动画 */\n65\t        MovementMixer = AnimationMixerPlayable.Create(RootGraph);\n66\t        if (MovementClips == null || MovementClips.Count == 0)\n67\t        {\n68\t            Debug.LogError(\"移动动画列表为空，无法初始化动画图！\");\n69\t            return RootGraph;\n70\t        }\n71\t\n72\t        foreach (var clip in MovementClips)\n73\t        {\n74\t            var clipPlayable = AnimationClipPlayable.Create(RootGraph, clip);\n75\t            MovementMixer.AddInput(clipPlayable, 0, 0f);\n76\t        }\n77\t        \n78\t        movementTargets = new float[MovementMixer.GetInputCount()];\n79\t        movementTargets[0] = 1f; // 默认激活第一个动画\n80\t        \n81\t        /* 通用动画 */\n82\t        CommonReactionMixer = AnimationMixerPlayable.Create(RootGraph);\n83\t        //先受击动画后死亡动画\n84\t        if (HitReactionClips != null)\n85\t        {\n86\t            foreach (var clip in HitReactionClips)\n87\t            {\n88\t                var HitPlayable = AnimationClipPlayable.Create(RootGraph, clip);\n89\t                CommonReactionMixer.AddInput(HitPlayable, 0, 0f);\n90\t            }\n91\t        }\n92\t\n93\t        if (DeathClips != null)\n94\t        {\n95\t            foreach (var clip in DeathClips)\n96\t            {\n97\t                var HitPlayable = AnimationClipPlayable.Create(RootGraph, clip);\n98\t                CommonReactionMixer.AddInput(HitPlayable, 0, 0f);\n99\t            }\n100\t        }\n101\t\n102\t        CommonReactionTargets = new float[CommonReactionMixer.GetInputCount()];\n103\t        if (CommonReactionTargets.Length > 0) CommonReactionTargets[0] = 1f;\n104\t        \n105\t        //创建攻击混合器\n106\t        AttackMixer = AnimationMixerPlayable.Create(RootGraph, 2);\n107\t        attackTargets = new float[2]; // 长度为1，初始为0\n108\t        attackTargets[0] = 1f;\n109\t        \n110\t        //InitializeAttackMixer(graph);\n111\t        \n112\t        //根混合器连接\n113\t        RootMixer = AnimationMixerPlayable.Create(RootGraph, 3); //暂时设置移动和攻击两节点\n114\t        RootGraph.Connect(MovementMixer, 0, RootMixer, 0);\n115\t        RootGraph.Connect(AttackMixer, 0, RootMixer, 1);\n116\t        RootGraph.Connect(CommonReactionMixer, 0, RootMixer, 2);\n117\t        \n118\t        output = AnimationPlayableOutput.Create(RootGraph, \"Anima\", animator);\n119\t        output.SetSourcePlayable(RootMixer);\n120\t        \n121\t        // 初始权重\n122\t        RootMixer.SetInputWeight(0, 1f); // 移动\n123\t        RootMixer.SetInputWeight(1, 0f); // 攻击\n124\t        RootMixer.SetInputWeight(2, 0f);\n125\t        \n126\t        Debug.Log(\"动画初始化成功\");\n127\t        \n128\t        RootGraph.Play();\n129\t        \n130\t        return RootGraph;\n131\t    }\n132\t    \n133\t    /* 混合更新 */\n134\t    public void UpdateBlend(float deltaTime)\n135\t    {\n136\t        // 更新移动混合器\n137\t        for (int i = 0; i < MovementMixer.GetInputCount(); i++)\n138\t        {\n139\t            float current = MovementMixer.GetInputWeight(i);\n140\t            float target = movementTargets[i];\n141\t            MovementMixer.SetInputWeight(i, Mathf.Lerp(\n142\t                current,\n143\t                target,\n144\t                1f - Mathf.Exp(-blendSpeed * deltaTime))\n145\t            );\n146\t        }\n147\t\n148\t        for (int i = 0; i < CommonReactionMixer.GetInputCount(); i++)\n149\t        {\n150\t            float current = CommonReactionMixer.GetInputWeight(i);\n151\t            float target = CommonReactionTargets[i];\n152\t            CommonReactionMixer.SetInputWeight(i ,Mathf.Lerp(\n153\t                current,\n154\t                target,\n155\t                1f - Mathf.Exp(-blendSpeed * deltaTime)\n156\t                ));\n157\t        }\n158\t\n159\t        // 更新根混合器\n160\t        float currentMove = RootMixer.GetInputWeight(0);\n161\t        float currentAttack = RootMixer.GetInputWeight(1);\n162\t        float CurrentCommonReacation = RootMixer.GetInputWeight(2);\n163\t        RootMixer.SetInputWeight(0, Mathf.Lerp(currentMove, targetMoveWeight, 1f - Mathf.Exp(-blendSpeed * deltaTime)));\n164\t        RootMixer.SetInputWeight(1, Mathf.Lerp(currentAttack, targetAttackWeight, 1f - Mathf.Exp(-blendSpeed * deltaTime)));\n165\t        RootMixer.SetInputWeight(2, Mathf.Lerp(CurrentCommonReacation, targetCommonReactionWeight, 1f - Mathf.Exp(-blendSpeed * deltaTime)));\n166\t    }\n167\t\n168\t    /* 播放攻击动画\n169\t     * AttackMixer 是权重混合器，端口必须始终保持有效连接，一旦某个端口为空，\n170\t     * 混合结果会退化成绑定姿势（T-pose）。因此这里只重建 Playable 并在同一帧内\n171\t     * 用 Connect 覆盖旧连接（Connect 会自动替换该端口的原有连接），\n172\t     * 绝不先 Disconnect 后再 Connect。*/\n173\t    public void PlayAttackClip(AnimationClip attackClip, AnimationClip EndClip, PlayableGraph graph, float speed = 1f)\n174\t    {\n175\t        if (attackClip == null || EndClip == null) return;\n176\t        if (!AttackMixer.IsValid())\n177\t        {\n178\t            Debug.LogError(\"AttackMixer未初始化！\");\n179\t            return;\n180\t        }\n181\t\n182\t        CachedAttackClipPlayable = CreateAttackPlayable(graph, attackClip, attackInputPort, speed);\n183\t        CachedEndClipPlayable = CreateAttackPlayable(graph, EndClip, attackEndInputPort, speed);\n184\t\n185\t        //两个端口都已持有有效动画后再切换权重\n186\t        AttackMixer.SetInputWeight(attackInputPort, 1f);\n187\t        AttackMixer.SetInputWeight(attackEndInputPort, 0f);\n188\t        SetRootTarget(0f, 1f, 0f); // 切换到攻击权重\n189\t    }\n190\t    \n191\t    /* 播放攻击停止动画\n192\t     * 只做同帧权重交接：先让收招端口拿到权重，再释放攻击端口权重，\n193\t     * 中间不存在端口为空或权重和为 0 的帧 */\n194\t    public void StartAttackEnd(PlayableGraph graph, float speed = 1f)\n195\t    {\n196\t        if (!AttackMixer.IsValid())\n197\t        {\n198\t            Debug.LogError(\"AttackMixer未初始化！\");\n199\t            return;\n200\t        }\n201\t        if (!CachedEndClipPlayable.IsValid()) return;\n202\t\n203\t        CachedEndClipPlayable.SetSpeed(speed);\n204\t        CachedEndClipPlayable.SetTime(0);\n205\t        CachedEndClipPlayable.SetDone(false);\n206\t\n207\t        AttackMixer.SetInputWeight(attackEndInputPort, 1f);\n208\t        AttackMixer.SetInputWeight(attackInputPort, 0f);\n209\t\n210\t        SetRootTarget(0f, 1f, 0f); // 保持攻击权重\n211\t    }\n212\t\n213\t    /* 创建攻击用 Playable 并覆盖连接到指定端口，同时重置时间与播放结束标记 */\n214\t    private AnimationClipPlayable CreateAttackPlayable(\n215\t        PlayableGraph graph,\n216\t        AnimationClip clip,\n217\t        int port,\n218\t        float speed)\n219\t    {\n220\t        var playable = AnimationClipPlayable.Create(graph, clip);\n221\t        playable.SetSpeed(speed);\n222\t        playable.SetTime(0);\n223\t        playable.SetDone(false);\n224\t\n225\t        //Connect 会替换 port 上原有的连接，旧 Playable 会被自动回收，端口不会出现空档\n226\t        graph.Connect(playable, 0, AttackMixer, port);\n227\t\n228\t        return playable;\n229\t    }\n230\t\n231\t    /* 设置移动动画混合 先将全部动画设置为0，然后将目标设置为1 */\n232\t    public void SetMovementTarget(int index, float weight = 1f)\n233\t    {\n234\t        if (index < 0 || index >= movementTargets.Length) return;\n235\t        for (int i = 0; i < movementTargets.Length; i++) movementTargets[i] = 0f;\n236\t        movementTargets[index] = weight;\n237\t        \n238\t        ResetAnimationTime(index);\n239\t    }\n240\t    \n241\t    /* 设置通用动画混合 先将全部动画设置为0，然后将目标设置为1 */\n242\t    public void SetCommonReacitonTarget(int index, float weight = 1f)\n243\t    {\n244\t        if (index < 0 || index >= CommonReactionTargets.Length) return;\n245\t        for (int i = 0; i < CommonReactionTargets.Length; i++) CommonReactionTargets[i] = 0f;\n246\t        CommonReactionTargets[index] = weight;\n247\t        \n248\t        ResetCommonReactionAnimationTime(index);\n249\t    }\n250\t    \n251\t    public void SetRootTarget(float move, float attack, float common)\n252\t    {\n253\t        targetMoveWeight = move;\n254\t        targetAttackWeight = attack;\n255\t        targetCommonReactionWeight = common;\n256\t    }\n257\t\n258\t    /* 重置动画时间 */\n259\t    private void ResetAnimationTime(int index)\n260\t    {\n261\t        var clip = MovementMixer.GetInput(index);\n262\t        if (clip.IsValid() && clip.GetPlayableType() == typeof(AnimationClipPlayable))\n263\t            ((AnimationClipPlayable)clip).SetTime(0);\n264\t    }\n265\t    \n266\t    public void ResetAttackAnimationTime(int index)\n267\t    {\n268\t        var clip = AttackMixer.GetInput(index);\n269\t        if (clip.IsValid() && clip.GetPlayableType() == typeof(AnimationClipPlayable))\n270\t            ((AnimationClipPlayable)clip).SetTime(0);\n271\t    }\n272\t    \n273\t    public void ResetCommonReactionAnimationTime(int index)\n274\t    {\n275\t        var clip = CommonReactionMixer.GetInput(index);\n276\t        if (clip.IsValid() && clip.GetPlayableType() == typeof(AnimationClipPlayable))\n277\t            ((AnimationClipPlayable)clip).SetTime(0);\n278\t    }\n279\t    \n280\t    /*/* 初始化攻击混合器 #1#\n281\t    private void InitializeAttackMixer(PlayableGraph graph)\n282\t    {\n283\t        AttackMixer = AnimationMixerPlayable.Create(graph, 1); // 只有一个输入\n284\t        graph.Connect(AttackMixer, 0, RootMixer, 1); // 连接到根混合器的输入1\n285\t        AttackMixer.SetInputWeight(attackInputPort, 0f); // 初始权重0\n286\t    }*/\n287\t\n288\t    #region 敌人专用\n289\t\n290\t    \n291\t\n292\t    #endregion\n293\t    \n294\t}\n295"
