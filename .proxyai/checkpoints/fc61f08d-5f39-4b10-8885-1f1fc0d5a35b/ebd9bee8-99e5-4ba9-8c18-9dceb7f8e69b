                    "text": "1\tusing System;\n2\tusing System.Collections.Generic;\n3\tusing System.Linq;\n4\tusing UnityEngine;\n5\tusing UnityEngine.Animations;\n6\tusing UnityEngine.Playables;\n7\t\n8\t/*\n9\t * 用于存放角色动画\n10\t * \n11\t */\n12\t\n13\t[Serializable]\n14\tpublic class AnimaClipsData\n15\t{\n16\t    [field:SerializeField]\n17\t    public List<AnimationClip> MovementClips { get; private set; }\n18\t    //[field:SerializeField]\n19\t    //public List<AnimationClip> AttackClips { get; private set; }\n20\t    [field:SerializeField]\n21\t    public List<AnimationClip> HitReactionClips { get; private set; }\n22\t    [field:SerializeField]\n23\t    public List<AnimationClip> DeathClips { get; private set; }\n24\t    \n25\t    //Mixer\n26\t    public AnimationMixerPlayable MovementMixer { get; private set; }\n27\t    public AnimationMixerPlayable AttackMixer { get; private set; }\n28\t    public AnimationMixerPlayable CommonReactionMixer { get; private set; }\n29\t\n30\t    public AnimationMixerPlayable RootMixer { get; private set; }\n31\t\n32\t    public AnimationPlayableOutput output { get; private set; }\n33\t    \n34\t    // 目标权重 原理：首先设置数组缓存动画目标，然后将目前的动画权重与缓存的索引进行lerp平滑处理，最后设置\n35\t    public float[] movementTargets { get; private set; }\n36\t    public float[] attackTargets{ get; private set; }\n37\t    public float[] CommonReactionTargets { get; private set; }\n38\t    public float targetMoveWeight{ get; private set; } = 1f;\n39\t    public float targetAttackWeight{ get; private set; } = 0f;\n40\t    public float targetCommonReactionWeight{ get; private set; } = 0f;\n41\t\n42\t    public float blendSpeed { get; private set; } = 8f; // 过渡速度\n43\t    \n44\t    //攻击节点\n45\t    //攻击端口索引\n46\t    private const int attackInputPort = 0;\n47\t    private const int attackEndInputPort = 1;\n48\t\n49\t    private PlayableGraph graph;\n50\t\n51\t    private AnimationClipPlayable CachedAttackClipPlayable;\n52\t    private AnimationClipPlayable CachedEndClipPlayable;\n53\t    \n54\t    public PlayableGraph Initialize(Animator animator, PlayableGraph RootGraph)\n55\t    {\n56\t        this.graph = RootGraph;\n57\t        \n58\t        if (!RootGraph.IsValid())\n59\t        {\n60\t            RootGraph = PlayableGraph.Create(\"PlayerAnimationGraph\");\n61\t            RootGraph.SetTimeUpdateMode(DirectorUpdateMode.GameTime);\n62\t        }\n63\t\n64\t        /* 移动动画 */\n65\t        MovementMixer = AnimationMixerPlayable.Create(RootGraph);\n66\t        if (MovementClips == null || MovementClips.Count == 0)\n67\t        {\n68\t            Debug.LogError(\"移动动画列表为空，无法初始化动画图！\");\n69\t            return RootGraph;\n70\t        }\n71\t\n72\t        foreach (var clip in MovementClips)\n73\t        {\n74\t            var clipPlayable = AnimationClipPlayable.Create(RootGraph, clip);\n75\t            MovementMixer.AddInput(clipPlayable, 0, 0f);\n76\t        }\n77\t        \n78\t        movementTargets = new float[MovementMixer.GetInputCount()];\n79\t        movementTargets[0] = 1f; // 默认激活第一个动画\n80\t        \n81\t        /* 通用动画 */\n82\t        CommonReactionMixer = AnimationMixerPlayable.Create(RootGraph);\n83\t        //先受击动画后死亡动画\n84\t        if (HitReactionClips != null)\n85\t        {\n86\t            foreach (var clip in HitReactionClips)\n87\t            {\n88\t                var HitPlayable = AnimationClipPlayable.Create(RootGraph, clip);\n89\t                CommonReactionMixer.AddInput(HitPlayable, 0, 0f);\n90\t            }\n91\t        }\n92\t\n93\t        if (DeathClips != null)\n94\t        {\n95\t            foreach (var clip in DeathClips)\n96\t            {\n97\t                var HitPlayable = AnimationClipPlayable.Create(RootGraph, clip);\n98\t                CommonReactionMixer.AddInput(HitPlayable, 0, 0f);\n99\t            }\n100\t        }\n101\t\n102\t        CommonReactionTargets = new float[CommonReactionMixer.GetInputCount()];\n103\t        if (CommonReactionTargets.Length > 0) CommonReactionTargets[0] = 1f;\n104\t        \n105\t        //创建攻击混合器\n106\t        /* 第三个参数 normalizeWeights 必须显式传 false。\n107\t           默认 true 时混合器会把每个输入权重除以权重总和，一旦所有端口权重\n108\t           同时为 0（例如上一段攻击结束、ClearEnemyCombo 刚把权重清零，\n109\t           或连招切换时端口被重建的中间帧），除以 0 会得到非法权重，\n110\t           混合结果退化成绑定姿势——表现就是骨骼被拉长、模型浮在原点上方。\n111\t           这里关闭归一化，由代码保证两个端口权重之和恒为 1 */\n112\t        AttackMixer = AnimationMixerPlayable.Create(RootGraph, 2, false);\n113\t        attackTargets = new float[2];\n114\t        attackTargets[0] = 1f;\n115\t        \n116\t        //InitializeAttackMixer(graph);\n117\t        \n118\t        //根混合器连接\n119\t        RootMixer = AnimationMixerPlayable.Create(RootGraph, 3, false); //暂时设置移动和攻击两节点\n120\t        RootGraph.Connect(MovementMixer, 0, RootMixer, 0);\n121\t        RootGraph.Connect(AttackMixer, 0, RootMixer, 1);\n122\t        RootGraph.Connect(CommonReactionMixer, 0, RootMixer, 2);\n123\t        \n124\t        output = AnimationPlayableOutput.Create(RootGraph, \"Anima\", animator);\n125\t        output.SetSourcePlayable(RootMixer);\n126\t        \n127\t        // 初始权重\n128\t        RootMixer.SetInputWeight(0, 1f); // 移动\n129\t        RootMixer.SetInputWeight(1, 0f); // 攻击\n130\t        RootMixer.SetInputWeight(2, 0f);\n131\t        \n132\t        Debug.Log(\"动画初始化成功\");\n133\t        \n134\t        RootGraph.Play();\n135\t        \n136\t        return RootGraph;\n137\t    }\n138\t    \n139\t    /* 混合更新 */\n140\t    public void UpdateBlend(float deltaTime)\n141\t    {\n142\t        // 更新移动混合器\n143\t        for (int i = 0; i < MovementMixer.GetInputCount(); i++)\n144\t        {\n145\t            float current = MovementMixer.GetInputWeight(i);\n146\t            float target = movementTargets[i];\n147\t            MovementMixer.SetInputWeight(i, Mathf.Lerp(\n148\t                current,\n149\t                target,\n150\t                1f - Mathf.Exp(-blendSpeed * deltaTime))\n151\t            );\n152\t        }\n153\t\n154\t        for (int i = 0; i < CommonReactionMixer.GetInputCount(); i++)\n155\t        {\n156\t            float current = CommonReactionMixer.GetInputWeight(i);\n157\t            float target = CommonReactionTargets[i];\n158\t            CommonReactionMixer.SetInputWeight(i ,Mathf.Lerp(\n159\t                current,\n160\t                target,\n161\t                1f - Mathf.Exp(-blendSpeed * deltaTime)\n162\t                ));\n163\t        }\n164\t\n165\t        // 更新根混合器\n166\t        float currentMove = RootMixer.GetInputWeight(0);\n167\t        float currentAttack = RootMixer.GetInputWeight(1);\n168\t        float CurrentCommonReacation = RootMixer.GetInputWeight(2);\n169\t\n170\t        float t = 1f - Mathf.Exp(-blendSpeed * deltaTime);\n171\t\n172\t        float newMove = Mathf.Lerp(currentMove, targetMoveWeight, t);\n173\t        float newAttack = Mathf.Lerp(currentAttack, targetAttackWeight, t);\n174\t        float newCommon = Mathf.Lerp(CurrentCommonReacation, targetCommonReactionWeight, t);\n175\t\n176\t        /* RootMixer 关闭了自动归一化，三个权重必须由代码显式归一化。\n177\t           否则过渡过程中三者之和可能偏离 1：大于 1 会让动画过冲，\n178\t           小于 1 会让混合结果向绑定姿势收敛（骨骼被拉长）。\n179\t           AttackMixer 同理，两个端口权重在这里一并归一化 */\n180\t        NormalizeRootWeights(ref newMove, ref newAttack, ref newCommon);\n181\t\n182\t        RootMixer.SetInputWeight(0, newMove);\n183\t        RootMixer.SetInputWeight(1, newAttack);\n184\t        RootMixer.SetInputWeight(2, newCommon);\n185\t\n186\t        NormalizeAttackWeights();\n187\t\n188\t        //端口重建与上面的权重写入错开一帧，避免同帧重建导致的绑定姿势闪烁\n189\t        PreloadNextEnemyComboIfNeeded();\n190\t    }\n191\t\n192\t    /* 把根混合器的三个权重按比例缩放到总和为 1 */\n193\t    private void NormalizeRootWeights(ref float move, ref float attack, ref float common)\n194\t    {\n195\t        float Sum = move + attack + common;\n196\t\n197\t        //三者都接近 0 时说明配置异常，退回到纯移动，避免出现 0 权重导致绑定姿势\n198\t        if (Sum < 0.0001f)\n199\t        {\n200\t            move = 1f;\n201\t            attack = 0f;\n202\t            common = 0f;\n203\t            return;\n204\t        }\n205\t\n206\t        move /= Sum;\n207\t        attack /= Sum;\n208\t        common /= Sum;\n209\t    }\n210\t\n211\t    /* 攻击混合器两个端口的权重同样必须归一化，否则端口权重和为 0 时\n212\t       混合结果会退化成绑定姿势 */\n213\t    private void NormalizeAttackWeights()\n214\t    {\n215\t        float w0 = AttackMixer.GetInputWeight(attackInputPort);\n216\t        float w1 = AttackMixer.GetInputWeight(attackEndInputPort);\n217\t        float Sum = w0 + w1;\n218\t\n219\t        if (Sum < 0.0001f) return;\n220\t\n221\t        AttackMixer.SetInputWeight(attackInputPort, w0 / Sum);\n222\t        AttackMixer.SetInputWeight(attackEndInputPort, w1 / Sum);\n223\t    }\n224\t\n225\t    /* 播放攻击动画\n226\t     * AttackMixer 是权重混合器，端口必须始终保持有效连接，一旦某个端口为空，\n227\t     * 混合结果会退化成绑定姿势（T-pose）。因此这里重建 Playable 并在同一帧内\n228\t     * 完成「断开旧连接 -> 连接新动画 -> 切换权重」，中间不执行求值，端口不会出现空档。*/\n229\t    public void PlayAttackClip(AnimationClip attackClip, AnimationClip EndClip, PlayableGraph graph, float speed = 1f)\n230\t    {\n231\t        if (attackClip == null || EndClip == null) return;\n232\t        if (!AttackMixer.IsValid())\n233\t        {\n234\t            Debug.LogError(\"AttackMixer未初始化！\");\n235\t            return;\n236\t        }\n237\t\n238\t        CachedAttackClipPlayable = CreateAttackPlayable(graph, attackClip, attackInputPort, speed);\n239\t        CachedEndClipPlayable = CreateAttackPlayable(graph, EndClip, attackEndInputPort, speed);\n240\t\n241\t        //两个端口都已持有有效动画后再切换权重\n242\t        AttackMixer.SetInputWeight(attackInputPort, 1f);\n243\t        AttackMixer.SetInputWeight(attackEndInputPort, 0f);\n244\t        SetRootTarget(0f, 1f, 0f); // 切换到攻击权重\n245\t    }\n246\t    \n247\t    /* 播放攻击停止动画\n248\t     * 只做同帧权重交接：先让收招端口拿到权重，再释放攻击端口权重，\n249\t     * 中间不存在端口为空或权重和为 0 的帧 */\n250\t    public void StartAttackEnd(PlayableGraph graph, float speed = 1f)\n251\t    {\n252\t        if (!AttackMixer.IsValid())\n253\t        {\n254\t            Debug.LogError(\"AttackMixer未初始化！\");\n255\t            return;\n256\t        }\n257\t        if (!CachedEndClipPlayable.IsValid()) return;\n258\t\n259\t        CachedEndClipPlayable.SetSpeed(speed);\n260\t        CachedEndClipPlayable.SetTime(0);\n261\t        CachedEndClipPlayable.SetDone(false);\n262\t\n263\t        AttackMixer.SetInputWeight(attackEndInputPort, 1f);\n264\t        AttackMixer.SetInputWeight(attackInputPort, 0f);\n265\t\n266\t        SetRootTarget(0f, 1f, 0f); // 保持攻击权重\n267\t    }\n268\t\n269\t    /* 在指定端口上设置攻击动画，并把播放时间与播放结束标记复位。\n270\t     *\n271\t     * 为什么不用「Destroy 旧节点再 Connect 新节点」：\n272\t     * AttackMixer 是 AnimationMixerPlayable，端口在求值时若为空，\n273\t     * 混合结果会退化成绑定姿势（骨骼被拉回 rig 默认姿态）。\n274\t     * Disconnect 之后到 Connect 之前虽然在同一函数内，但只要端口曾经空过，\n275\t     * 该端口上的旧 Clip 引用就已经失效，后续每段连招都会命中这个空档，\n276\t     * 表现就是「第一招正常，之后每一招骨骼被拉长」。\n277\t     *\n278\t     * 因此这里采用「端口常驻」策略：\n279\t     * 旧节点只断开、不销毁，句柄记录在 PendingDestroy 里，\n280\t     * 等新节点连好之后统一回收，保证端口全程有效。 */\n281\t    private AnimationClipPlayable CreateAttackPlayable(\n282\t        PlayableGraph graph,\n283\t        AnimationClip clip,\n284\t        int port,\n285\t        float speed)\n286\t    {\n287\t        var playable = AnimationClipPlayable.Create(graph, clip);\n288\t        playable.SetSpeed(speed);\n289\t        playable.SetTime(0);\n290\t        playable.SetDone(false);\n291\t\n292\t        //先断开旧连接（不销毁），参数槽位立刻被新节点占用\n293\t        var Previous = AttackMixer.GetInput(port);\n294\t        bool bHasPrevious = Previous.IsValid() && Previous.GetPlayableType() == typeof(AnimationClipPlayable);\n295\t\n296\t        if (Previous.IsValid()) graph.Disconnect(AttackMixer, port);\n297\t\n298\t        graph.Connect(playable, 0, AttackMixer, port);\n299\t\n300\t        //新节点已接管该端口，此时回收旧节点不会再造成空档\n301\t        if (bHasPrevious) Previous.Destroy();\n302\t\n303\t        return playable;\n304\t    }\n305\t\n306\t    /* 设置移动动画混合 先将全部动画设置为0，然后将目标设置为1 */\n307\t    public void SetMovementTarget(int index, float weight = 1f)\n308\t    {\n309\t        if (index < 0 || index >= movementTargets.Length) return;\n310\t        for (int i = 0; i < movementTargets.Length; i++) movementTargets[i] = 0f;\n311\t        movementTargets[index] = weight;\n312\t        \n313\t        ResetAnimationTime(index);\n314\t    }\n315\t    \n316\t    /* 设置通用动画混合 先将全部动画设置为0，然后将目标设置为1 */\n317\t    public void SetCommonReacitonTarget(int index, float weight = 1f)\n318\t    {\n319\t        if (index < 0 || index >= CommonReactionTargets.Length) return;\n320\t        for (int i = 0; i < CommonReactionTargets.Length; i++) CommonReactionTargets[i] = 0f;\n321\t        CommonReactionTargets[index] = weight;\n322\t        \n323\t        ResetCommonReactionAnimationTime(index);\n324\t    }\n325\t    \n326\t    public void SetRootTarget(float move, float attack, float common)\n327\t    {\n328\t        targetMoveWeight = move;\n329\t        targetAttackWeight = attack;\n330\t        targetCommonReactionWeight = common;\n331\t    }\n332\t\n333\t    /* 重置动画时间 */\n334\t    private void ResetAnimationTime(int index)\n335\t    {\n336\t        var clip = MovementMixer.GetInput(index);\n337\t        if (clip.IsValid() && clip.GetPlayableType() == typeof(AnimationClipPlayable))\n338\t            ((AnimationClipPlayable)clip).SetTime(0);\n339\t    }\n340\t    \n341\t    public void ResetAttackAnimationTime(int index)\n342\t    {\n343\t        var clip = AttackMixer.GetInput(index);\n344\t        if (clip.IsValid() && clip.GetPlayableType() == typeof(AnimationClipPlayable))\n345\t            ((AnimationClipPlayable)clip).SetTime(0);\n346\t    }\n347\t    \n348\t    public void ResetCommonReactionAnimationTime(int index)\n349\t    {\n350\t        var clip = CommonReactionMixer.GetInput(index);\n351\t        if (clip.IsValid() && clip.GetPlayableType() == typeof(AnimationClipPlayable))\n352\t            ((AnimationClipPlayable)clip).SetTime(0);\n353\t    }\n354\t    \n355\t    /*/* 初始化攻击混合器 #1#\n356\t    private void InitializeAttackMixer(PlayableGraph graph)\n357\t    {\n358\t        AttackMixer = AnimationMixerPlayable.Create(graph, 1); // 只有一个输入\n359\t        graph.Connect(AttackMixer, 0, RootMixer, 1); // 连接到根混合器的输入1\n360\t        AttackMixer.SetInputWeight(attackInputPort, 0f); // 初始权重0\n361\t    }*/\n362\t\n363\t    #region 敌人专用\n364\t\n365\t    /* 当前正在使用的敌人能力数据，直到下一次传入新的技能数据前一直沿用 */\n366\t    private EnemyAbilityData CurrentEnemyAbility;\n367\t\n368\t    /* 当前连招段索引，指向 AttackClips 中正在播放的那一段 */\n369\t    private int EnemyComboIndex;\n370\t\n371\t    /* 当前正在播放的端口（0 或 1），另一端口用于预缓存下一段连招 */\n372\t    private int EnemyComboActivePort = attackInputPort;\n373\t\n374\t    /* 预缓存端口上已经准备好了下一段连招 */\n375\t    private bool bEnemyComboPreloaded;\n376\t\n377\t    /* 腾空端口待预缓存：端口重建与权重交接错开一帧执行 */\n378\t    private bool bHasPendingPreload;\n379\t    private int PendingPreloadPort = -1;\n380\t\n381\t    /* 当前连招段索引，供状态机查询进度 */\n382\t    public int CurrentEnemyComboIndex => EnemyComboIndex;\n383\t\n384\t    /* 当前连招总段数 */\n385\t    public int CurrentEnemyComboCount => CurrentEnemyAbility?.AttackClips?.Count ?? 0;\n386\t\n387\t    /* 是否还有下一段连招 */\n388\t    public bool bHasNextEnemyCombo => CurrentEnemyAbility != null\n389\t                                     && EnemyComboIndex + 1 < CurrentEnemyComboCount;\n390\t\n391\t    /* 预缓存端口索引，始终是当前播放端口的另一侧 */\n392\t    private int EnemyComboPreloadPort =>\n393\t        EnemyComboActivePort == attackInputPort ? attackEndInputPort : attackInputPort;\n394\t\n395\t    /* 播放敌人连招的第一段\n396\t     * ability 为本次攻击使用的技能数据，会重置连招进度从第 0 段开始。\n397\t     * 双端口乒乓：端口0 播放第 N 段时，端口1 已经缓存好第 N+1 段，\n398\t     * 切换时只需交换权重，动画切换在同一帧完成，不会出现空端口导致绑定姿势。\n399\t     * 敌人没有收招动画，连招一直播到最后一段为止。 */\n400\t    public bool PlayEnemyComboClip(EnemyAbilityData ability, PlayableGraph graph)\n401\t    {\n402\t        if (ability == null)\n403\t        {\n404\t            Debug.LogError(\"敌人技能数据为空，无法播放连招动画！\");\n405\t            return false;\n406\t        }\n407\t\n408\t        if (!AttackMixer.IsValid())\n409\t        {\n410\t            Debug.LogError(\"AttackMixer未初始化！\");\n411\t            return false;\n412\t        }\n413\t\n414\t        if (ability.AttackClips == null || ability.AttackClips.Count == 0)\n415\t        {\n416\t            Debug.LogError($\"技能 {ability.skillName} 的连招动画列表为空！\");\n417\t            return false;\n418\t        }\n419\t\n420\t        CurrentEnemyAbility = ability;\n421\t        EnemyComboIndex = 0;\n422\t        EnemyComboActivePort = attackInputPort;\n423\t        bEnemyComboPreloaded = false;\n424\t\n425\t        //第一个端口立刻播放第一段，第二端口预缓存第二段（没有第二段则缓存第一段占位）\n426\t        CacheEnemyComboClipAt(graph, EnemyComboActivePort, EnemyComboIndex);\n427\t        CacheEnemyComboClipAt(graph, EnemyComboPreloadPort, EnemyComboIndex + 1);\n428\t\n429\t        AttackMixer.SetInputWeight(EnemyComboActivePort, 1f);\n430\t        AttackMixer.SetInputWeight(EnemyComboPreloadPort, 0f);\n431\t        SetRootTarget(0f, 1f, 0f); // 切换到攻击权重\n432\t\n433\t        return true;\n434\t    }\n435\t\n436\t    /* 推进到下一段连招：交换端口，当前段播完后由预缓存段接管。\n437\t     * 已是最后一段时返回 false，由调用方决定如何结束攻击。\n438\t     *\n439\t     * 注意：这里刻意不在切换后立刻给腾空的端口预缓存下一段。\n440\t     * CreateAttackPlayable 会 Disconnect + Connect，改变该端口的输入对象，\n441\t     * 而 AnimationMixerPlayable 在输入被替换的那一帧会重建内部混合缓冲，\n442\t     * 该帧求值会闪出绑定姿势（表现为第一招切第二招时闪一下骨骼拉长）。\n443\t     * 预缓存推迟到下一帧由 PreloadNextEnemyComboIfNeeded 完成，\n444\t     * 保证「权重交接」和「端口重建」永远不在同一帧发生 */\n445\t    public bool PlayNextEnemyComboClip(PlayableGraph graph)\n446\t    {\n447\t        if (!bHasNextEnemyCombo) return false;\n448\t\n449\t        //先记下本次要停用（腾空）的端口。必须在交换 ActivePort 之前取，\n450\t        //否则 EnemyComboPreloadPort 会翻转成正在播放的端口\n451\t        int VacatedPort = EnemyComboActivePort;\n452\t        int NextPort = EnemyComboPreloadPort;\n453\t\n454\t        //预缓存段直接接管播放，不需要重新连接，避免切换瞬间出现空端口\n455\t        if (!bEnemyComboPreloaded)\n456\t        {\n457\t            CacheEnemyComboClipAt(graph, NextPort, EnemyComboIndex + 1);\n458\t        }\n459\t\n460\t        EnemyComboIndex++;\n461\t        EnemyComboActivePort = NextPort;\n462\t        bEnemyComboPreloaded = false;\n463\t\n464\t        //权重交接：两个端口在同一帧内写入，和不超过 1\n465\t        AttackMixer.SetInputWeight(EnemyComboActivePort, 1f);\n466\t        AttackMixer.SetInputWeight(VacatedPort, 0f);\n467\t\n468\t        //标记腾空端口待预缓存，实际重建留到下一帧，避免与权重交接同帧\n469\t        PendingPreloadPort = VacatedPort;\n470\t        bHasPendingPreload = true;\n471\t\n472\t        SetRootTarget(0f, 1f, 0f); // 保持攻击权重\n473\t        return true;\n474\t    }\n475\t\n476\t    /* 在安全的帧上补上腾空端口的预缓存。由 UpdateBlend 每帧调用，\n477\t       与权重交接错开一帧，避免同帧重建端口导致的绑定姿势闪烁。\n478\t       这里用 Initialize 时缓存的 graph，不需要外部再传 */\n479\t    private void PreloadNextEnemyComboIfNeeded()\n480\t    {\n481\t        if (!bHasPendingPreload) return;\n482\t\n483\t        bHasPendingPreload = false;\n484\t\n485\t        if (CurrentEnemyAbility == null) return;\n486\t        if (!graph.IsValid()) return;\n487\t\n488\t        //只在端口确实腾空（权重为 0）时才重建，避免打断正在播放的段\n489\t        if (PendingPreloadPort < 0 || PendingPreloadPort == EnemyComboActivePort) return;\n490\t        if (AttackMixer.GetInputWeight(PendingPreloadPort) > 0.0001f) return;\n491\t\n492\t        CacheEnemyComboClipAt(graph, PendingPreloadPort, EnemyComboIndex + 1);\n493\t    }\n494\t\n495\t    /* 在指定端口上覆盖连接一段连招动画，并把播放时间与结束标记复位 */\n496\t    private void CacheEnemyComboClipAt(PlayableGraph graph, int port, int index)\n497\t    {\n498\t        var ComboClips = CurrentEnemyAbility.AttackClips;\n499\t\n500\t        //越界说明没有下一段了，用第一段占位，保证端口永远有效，不会退化成绑定姿势\n501\t        bool bHasRealClip = index >= 0 && index < ComboClips.Count;\n502\t        int ClipIndex = bHasRealClip ? index : 0;\n503\t\n504\t        CreateAttackPlayable(\n505\t            graph,\n506\t            ComboClips[ClipIndex],\n507\t            port,\n508\t            CurrentEnemyAbility.animationSpeed);\n509\t\n510\t        //只有缓存到真正的下一段才算预缓存完成，占位动画不能置位\n511\t        if (bHasRealClip && port != EnemyComboActivePort) bEnemyComboPreloaded = true;\n512\t    }\n