                    "text": "1\tusing UnityEngine;\n2\tusing UnityEngine.Playables;\n3\t\n4\t/*\n5\t * 玩家类\n6\t * \n7\t */\n8\t\n9\t[RequireComponent(typeof(PlayerInput))] //当添加Player组件后也会自动添加PlayerInput组件\n10\tpublic class Player : CommonActor\n11\t{\n12\t    [field:SerializeField][field:Header(\"数据\")]\n13\t    public Player_SO AssetData { get; private set; } //通用数据资产\n14\t\n15\t    [field:SerializeField]\n16\t    public Player_CommonSO CommonAssetData { get; private set; }\n17\t    \n18\t    [field: SerializeField]\n19\t    [field: Header(\"技能资产\")]\n20\t    public Player_AbilitySet Abilities { get; private set; }\n21\t\n22\t    [field: SerializeField]\n23\t    [field: Header(\"角色骨骼\")]\n24\t    public Transform CharacterBone { get; private set; }\n25\t\n26\t    [field:SerializeField] [field:Header(\"胶囊体碰撞数据\")]\n27\t    public CapsuleColliderUtility ColliderUtility { get; private set; }\n28\t    \n29\t    [field:SerializeField][field:Header(\"地面\")]\n30\t    public Player_LayerData LayerData { get; private set; }\n31\t    \n32\t    [field: SerializeField][field:Header(\"动画\")]\n33\t    public AnimaClipsData AnimationClipData { get; private set; }\n34\t\n35\t    [field: SerializeField] [field: Header(\"武器碰撞器\")]\n36\t    public SharedWeaponHitBox PlayerWeaponHitBox { get; private set; }\n37\t    \n38\t    [field: Header(\"玩家界面UI\")]\n39\t    public HUDManager PlayerHUD { get; private set; }\n40\t\n41\t    public Rigidbody RigidBody { get; private set; } //刚体组件\n42\t    public PlayerInput playerInput { get; private set; }\n43\t    public Animator animator { get; private set; }\n44\t    public PlayableGraph AnimationGraph { get; private set; }\n45\t    \n46\t    public Transform MainCameraTransform { get; private set; } //摄像机位置\n47\t\n48\t    public Player_MovementStateMachine MovementStateMachine;\n49\t    public Player_CombatStateMachine CombatStateMachine;\n50\t\n51\t    public PlayStateMode CurrentStateMode = PlayStateMode.Movement;\n52\t    \n53\t    //TODO 测试\n54\t    public static Player Instance { get; private set; }\n55\t\n56\t    private void Awake()\n57\t    {\n58\t        /* 测试区域 */\n59\t        if (Instance != null && Instance != this) Destroy(gameObject);\n60\t        else Instance = this;\n61\t        /* 测试区域 */\n62\t        \n63\t        MovementStateMachine = new Player_MovementStateMachine(this);\n64\t        CombatStateMachine = new Player_CombatStateMachine(this);\n65\t        RigidBody = GetComponent<Rigidbody>();\n66\t        playerInput = GetComponent<PlayerInput>(); //从组件中获取\n67\t        animator = GetComponentInChildren<Animator>();\n68\t        \n69\t        ColliderUtility.InitColliderData(gameObject);\n70\t        ColliderUtility.CalculateCapsuleColliderDimensions();\n71\t        \n72\t        MainCameraTransform = Camera.main.transform;\n73\t\n74\t        PlayerHUD = GetComponent<HUDManager>();\n75\t        \n76\t        //AnimationGraph = AnimationClipData.Initialize(animator, AnimationGraph);\n77\t        //CharacterBone = FindCharacterBoneByName(transform, \"Bip001\");\n78\t    }\n79\t\n80\t    private void OnValidate() //在编辑器中更新\n81\t    {\n82\t        ColliderUtility.InitColliderData(gameObject);\n83\t        ColliderUtility.CalculateCapsuleColliderDimensions();\n84\t    }\n85\t    \n86\t    private void Start()\n87\t    {\n88\t        CommonAssetData.commonData.InitData();\n89\t        MovementStateMachine.ChangeState(MovementStateMachine.IdleState);\n90\t        //AnimationGraph.Play();\n91\t        //if(PlayerWeaponHitBox != null) Debug.Log(\"碰撞体初始化成功\");\n92\t    }\n93\t\n94\t    private void Update()\n95\t    {\n96\t        //if (Input.GetKey(KeyCode.Space)) TakeDamage(1f);\n97\t        \n98\t        switch (CurrentStateMode)\n99\t        {\n100\t            case PlayStateMode.Movement:\n101\t                MovementStateMachine.HandleInput(); //检测输入\n102\t                MovementStateMachine.Update();\n103\t                break;\n104\t            case PlayStateMode.Combat:\n105\t                CombatStateMachine.HandleInput();\n106\t                CombatStateMachine.Update();\n107\t                break;\n108\t        }\n109\t    }\n110\t    \n111\t    private void FixedUpdate()\n112\t    {\n113\t        switch (CurrentStateMode)\n114\t        {\n115\t            case PlayStateMode.Movement:\n116\t                MovementStateMachine.PhysicsUpdate();\n117\t                BindCombatInputAciton();\n118\t                break;\n119\t            case PlayStateMode.Combat:\n120\t                CombatStateMachine.PhysicsUpdate();\n121\t                UnbindCombatInputAction();\n122\t                break;\n123\t        }\n124\t        \n125\t        AnimationClipData.UpdateBlend(Time.deltaTime);\n126\t    }\n127\t    \n128\t    public void OnMovementStateAnimationEnterEvent()\n129\t    {\n130\t        MovementStateMachine.OnAnimationEnterEvent();\n131\t        CombatStateMachine.OnAnimationEnterEvent();\n132\t    }\n133\t    \n134\t    public void OnMovementStateAnimationExitEvent()\n135\t    {\n136\t        MovementStateMachine.OnAnimationExitEvent();\n137\t        CombatStateMachine.OnAnimationExitEvent();\n138\t    }\n139\t    \n140\t    public void OnMovementStateAnimationTransitionEvent()\n141\t    {\n142\t        MovementStateMachine.OnAnimationTransitionEvent();\n143\t        CombatStateMachine.OnAnimationTransitionEvent();\n144\t    }\n145\t\n146\t    private void OnEnable()\n147\t    {\n148\t        AnimationGraph = AnimationClipData.Initialize(animator, AnimationGraph);\n149\t        \n150\t        BindCombatInputAciton();\n151\t    }\n152\t\n153\t\n154\t\n155\t    private void OnDisable()\n156\t    {\n157\t        AnimationGraph.Destroy();\n158\t\n159\t        UnbindCombatInputAction();\n160\t    }\n161\t\n162\t    #region 技能绑定/解绑函数\n163\t    //通过绑定能力数据里的输入，然后单个检测不同技能不同按键\n164\t    private void BindCombatInputAciton()\n165\t    {\n166\t        if (Abilities == null) return;\n167\t        \n168\t        foreach (var Ability in Abilities.AbilitiesList)\n169\t        {\n170\t            if (Ability.inputAction != null && Ability.inputAction.action != null)\n171\t            {\n172\t                Ability.inputAction.action.started += ctx => OnAttackInput(Ability);\n173\t            }\n174\t        }\n175\t    }\n176\t\n177\t    private void UnbindCombatInputAction()\n178\t    {\n179\t        foreach (var Ability in Abilities.AbilitiesList)\n180\t        {\n181\t            if (Ability.inputAction != null && Ability.inputAction.action != null)\n182\t            {\n183\t                Ability.inputAction.action.started -= ctx => OnAttackInput(Ability);\n184\t            }\n185\t        }\n186\t    }\n187\t\n188\t    private void OnAttackInput(AbilitiesData ability)\n189\t    {\n190\t        if (CurrentStateMode == PlayStateMode.Movement)\n191\t        {\n192\t            CurrentStateMode = PlayStateMode.Combat;\n193\t            MovementStateMachine.ChangeState(MovementStateMachine.IdleState);\n194\t            CombatStateMachine.AttackState.CachedAbilitiesData = ability;\n195\t            CombatStateMachine.AttackEndState.CachedAbilitiesData = ability;\n196\t            PlayerWeaponHitBox.SetCachedDamage(CalculateDamageTaken(ability)); //将伤害传入碰撞体\n197\t            CombatStateMachine.ChangeState(CombatStateMachine.AttackState);\n198\t        }\n199\t        else if (CurrentStateMode == PlayStateMode.Combat)\n200\t        {\n201\t            //TODO 攻击预输入处理\n202\t        }\n203\t    }\n204\t\n205\t    /* 计算伤害 技能伤害 * 玩家伤害倍率 */\n206\t    private float CalculateDamageTaken(AbilitiesData ability)\n207\t    {\n208\t        return ability.AbilityDamage * CommonAssetData.commonData.CommonDamageScales;\n209\t    }\n210\t\n211\t    #endregion\n212\t\n213\t    #region 角色模型骨骼\n214\t\n215\t    /* 通过父类查找子类（骨骼） */\n216\t    private Transform FindCharacterBoneByName(Transform parent, string name)\n217\t    {\n218\t        if (parent.name == name) return parent;\n219\t        foreach (Transform child in parent)\n220\t        {\n221\t            var Result = FindCharacterBoneByName(child, name);\n222\t            if(Result != null) return Result;\n223\t        }\n224\t\n225\t        return null;\n226\t    }\n227\t\n228\t    private Vector3 GetMeshLastPosition()\n229\t    {\n230\t        if (CharacterBone == null) return new Vector3();\n231\t        return CharacterBone.position;\n232\t    }\n233\t    \n234\t    /* 将位置更新为模型位置 */\n235\t    private void UpdateRigidBodyToMeshPosition()\n236\t    {\n237\t        if (CharacterBone == null) return;\n238\t        \n239\t        Vector3 CurrentPostion = CharacterBone.InverseTransformPoint(CharacterBone.position); //获取模型位置\n240\t        Vector3 Delta = CurrentPostion - MovementStateMachine.ReusableData.LastMeshPosition; //位置差值\n241\t\n242\t        Vector3 worldDelta = CharacterBone.TransformDirection(Delta); //转化为世界坐标\n243\t        \n244\t        worldDelta.y = 0f; //只考虑水平\n245\t        if (worldDelta.sqrMagnitude > 0.0001f)\n246\t        {\n247\t            RigidBody.MovePosition(RigidBody.position + worldDelta);\n248\t        }\n249\t\n250\t        MovementStateMachine.ReusableData.LastMeshPosition = CurrentPostion;\n251\t    }\n252\t    \n253\t    #endregion\n254\t\n255\t    #region 接口实现\n256\t\n257\t    public bool bCanNotInterruptAttack { get; private set; }\n258\t\n259\t    public bool SetCanNotInterruptAttack(bool bSet)\n260\t    {\n261\t        bCanNotInterruptAttack = bSet;\n262\t        return bCanNotInterruptAttack;\n263\t    }\n264\t\n265\t    public override void TakeDamage(float damage, CommonActor Executor)\n266\t    {\n267\t        CommonAssetData.commonData.SetCurrentHealthDamage = damage;\n268\t        Debug.Log($\"{Executor.GetType()}对玩家造成当前伤害： {damage},玩家当前血量：{CommonAssetData.commonData.CurrentHealth}\");\n269\t        \n270\t        if (bCanNotInterruptAttack)\n271\t        {\n272\t            if (CurrentStateMode == PlayStateMode.Movement)\n273\t            {\n274\t                PlayHitReaction(Executor);\n275\t            }\n276\t        }\n277\t        else\n278\t        {\n279\t            PlayHitReaction(Executor);\n280\t        }\n281\t    }\n282\t\n283\t    public override void PlayHitReaction(CommonActor Executor)\n284\t    {\n285\t        MovementStateMachine.HitReactionState.SetExecutorRef(Executor);\n286\t        MovementStateMachine.ChangeState(MovementStateMachine.HitReactionState);\n287\t\n288\t    }\n289\t\n290\t    #endregion\n291\t    \n292\t\n293\t}\n294"
                }
